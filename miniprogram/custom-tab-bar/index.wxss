:host {
  background: transparent;
}

.tab-bar-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  /* 首次绘制必须默认藏在屏幕外：数据绑定晚一帧时也不能先闪出可见态。 */
  opacity: 0;
  transform: translateY(100%);
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease-out;
  pointer-events: none;
}

.tab-bar-wrap--visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.tab-items-wrap {
  position: relative;
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
  width: calc(100% - 76.92308rpx);
  height: 52px;
  margin: 0 38.46154rpx;
  padding: 4px 7.69231rpx;
  align-items: center;
  border-radius: 26px;
  background: transparent;
  box-shadow: 0 5.76923rpx 23.07692rpx rgba(100, 116, 139, 0.101961);
}

/*
 * 页面弹窗遮罩已经位于 TabBar 下方。毛玻璃会采样到遮罩后的页面，不能再在
 * 圆角栏内叠一层深色，否则这里会比周边多遮一次。弹窗期间只淡化 TabBar
 * 自身的白色填充、描边和前景控件，底色继续由同一张页面遮罩提供。
 */
.tab-items-wrap--modal {
  box-shadow: none;
}

.tab-items-wrap--modal .tab-glass-fill {
  opacity: 0;
}

.tab-items-wrap--modal .tab-glass-stroke,
.tab-items-wrap--modal .tab-item,
.tab-items-wrap--modal .tab-create-item {
  opacity: 0.6;
}

.tab-glass-blur,
.tab-glass-fill {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.tab-glass-blur {
  z-index: 0;
  background: transparent;
}

.tab-glass-fill {
  z-index: 1;
}

.tab-glass-stroke {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.tab-item {
  position: relative;
  z-index: 3;
  display: block;
  box-sizing: border-box;
  min-width: 0;
  height: 44px;
  flex: 1;
  border-radius: 22px;
  pointer-events: auto;
}

.tab-create-item {
  position: relative;
  z-index: 3;
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 44px;
  flex: 1;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.tab-create-button {
  display: flex;
  width: 34px;
  height: 26px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #ff9800;
  box-shadow: 0 3.84615rpx 11.53846rpx rgba(255, 152, 0, 0.2);
}

.tab-create-icon {
  display: block;
  width: 16px;
  height: 16px;
  pointer-events: none;
}

.tab-item--active {
  background: rgba(255, 255, 255, 0.901961);
  box-shadow: 0 3.84615rpx 15.38462rpx rgba(100, 116, 139, 0.070588);
}

.tab-icon {
  position: absolute;
  top: 5px;
  left: 50%;
  display: block;
  overflow: hidden;
  width: 18px;
  height: 18px;
  transform: translateX(-50%);
}

.tab-icon-glyph {
  /* Skyline 与 WebView 对横向裁切 SVG sprite 的栅格化不同，两个状态固定重叠在同一 18px 图标框内。 */
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 18px;
  height: 18px;
  opacity: 1;
  pointer-events: none;
}

.tab-icon-glyph--hidden {
  opacity: 0;
}

.tab-label {
  position: absolute;
  top: 25px;
  left: 0;
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 14px;
  margin: 0;
  padding: 0;
  color: #111827;
  font-size: 10px;
  line-height: 14px;
  font-weight: 400;
  text-align: center;
  white-space: nowrap;
}

.tab-label--active {
  color: #f59e0b;
}

.tab-modal-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: block;
  background: transparent;
  pointer-events: auto;
}
