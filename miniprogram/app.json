{
  "pages": [
    "pages/activity_list/activity_list",
    "pages/activity_calendar/activity_calendar",
    "pages/tools/tools",
    "pages/activity_detail/activity_detail",
    "pages/activity_cover_preview/activity_cover_preview",
    "pages/welcome/welcome",
    "pages/history/history",
    "pages/profile/profile",
    "pages/checkin_map/checkin_map",
    "pages/chwazi/chwazi"
  ],
  "window": {
    "navigationBarTitleText": "Dragon Reserve",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "backgroundTextStyle": "light",
    "backgroundColor": "#f5f5f5"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#007aff",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/activity_list/activity_list",
        "text": "Home",
        "iconPath": "images/tab-home.jpg",
        "selectedIconPath": "images/tab-home-active.jpg"
      },
      {
        "pagePath": "pages/tools/tools",
        "text": "Tools",
        "iconPath": "images/tab-home.png",
        "selectedIconPath": "images/tab-home-active.png"
      },
      {
        "pagePath": "pages/history/history",
        "text": "Ranking",
        "iconPath": "images/tab-ranking.jpg",
        "selectedIconPath": "images/tab-ranking-active.jpg"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "Profile",
        "iconPath": "images/tab-profile.jpg",
        "selectedIconPath": "images/tab-profile-active.jpg"
      }
    ]
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "keyframeStyleIsolation": "legacy",
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0"
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "permission": {
    "scope.userLocation": {
      "desc": "Select activity location"
    }
  },
  "subPackages": []
}
