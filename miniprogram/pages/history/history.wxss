@import "../../styles/dragonChrome.wxss";

page { background: #ffffff; overflow: hidden; }
.ranking-page { min-height: 100vh; background: #ffffff; color: #111827; overflow: hidden; }
.ranking-watermark { left: calc(50% - 25rpx); z-index: 0; }
.ranking-navbar { position: relative; z-index: 10; background: transparent; }
.ranking-navbar-row { box-sizing: border-box; display: flex; width: 100%; max-width: 480px; height: 84.62rpx; margin: 0 auto; padding: 0 38.46rpx; align-items: center; }
.ranking-navbar-title { color: #0a0a0a; font-size: 46.15rpx; font-weight: 600; line-height: 1; transform: translateY(-1.92rpx); }
.ranking-scroll { position: fixed; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; }
.ranking-scroll-body { position: relative; width: 100%; min-height: 100%; }
.ranking-content { position: relative; z-index: 2; box-sizing: border-box; display: flex; width: 100%; max-width: 480px; min-height: 100%; margin: 0 auto; padding: 15.38rpx 38.46rpx; flex-direction: column; }

.ranking-switch { position: relative; display: flex; box-sizing: border-box; width: 100%; height: 76.92rpx; padding: 7.69rpx; gap: 7.69rpx; border-radius: 23.08rpx; background: #f5f5f5; flex: none; }
.ranking-switch-slider { position: absolute; z-index: 0; top: 7.69rpx; bottom: 7.69rpx; left: 7.69rpx; width: calc((100% - 23.07rpx) / 2); border-radius: 15.38rpx; background: #ffffff; box-shadow: 0 3.85rpx 19.23rpx rgba(0,0,0,.08); transform: translateX(0); transition: transform 180ms cubic-bezier(.2,.8,.2,1); pointer-events: none; }
.ranking-switch-slider.is-pigeon { transform: translateX(calc(100% + 7.69rpx)); }
.ranking-switch-item { position: relative; z-index: 1; display: flex; min-width: 0; height: 61.54rpx; flex: 1; align-items: center; justify-content: center; border-radius: 15.38rpx; color: #4b5563; font-size: 26.92rpx; font-weight: 500; transition: color 160ms ease; }
.ranking-switch-item.is-active { color: #ff9800; font-weight: 600; }
.ranking-loading,.ranking-empty-small { display: flex; min-height: 230.77rpx; align-items: center; justify-content: center; color: #9ca3af; font-size: 26.92rpx; }
.ranking-section-title { height: 42.31rpx; margin-top: 38.46rpx; color: #000; font-size: 38.46rpx; font-weight: 700; line-height: 42.31rpx; }
.ranking-section-title--others { margin-top: 61.54rpx; }

.champion-card { display: flex; box-sizing: border-box; width: 100%; height: 430.77rpx; margin-top: 15.38rpx; padding: 30.77rpx; gap: 23.08rpx; align-items: center; border-radius: 46.15rpx; background: #ff9800; box-shadow: 0 19.23rpx 53.85rpx rgba(0,0,0,.15); }
.champion-profile { display: flex; width: 184.62rpx; height: 100%; flex: none; flex-direction: column; gap: 15.38rpx; align-items: center; justify-content: center; }
.champion-avatar { box-sizing: border-box; width: 138.46rpx; height: 138.46rpx; border: 6.73rpx solid #fff; border-radius: 50%; background: #fff3e0; box-shadow: 0 11.54rpx 38.46rpx rgba(0,0,0,.1); }
.champion-name { width: 100%; overflow: hidden; color: #fff; font-size: 30.77rpx; font-weight: 700; line-height: 38.46rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.champion-number { height: 73.08rpx; color: #fff; font-size: 61.54rpx; font-weight: 700; line-height: 73.08rpx; text-align: center; }
.champion-unit { color: #fff3e0; font-size: 19.23rpx; font-weight: 500; line-height: 30.77rpx; }
.champion-detail { display: flex; min-width: 0; height: 100%; flex: 1; flex-direction: column; gap: 15.38rpx; align-items: flex-end; justify-content: center; }
.champion-joke { width: 398.08rpx; max-width: 100%; height: 32.69rpx; overflow: hidden; color: #fff; font-size: 23.08rpx; font-weight: 600; line-height: 32.69rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }

.heatmap-card { display: flex; box-sizing: border-box; width: 100%; height: 384.62rpx; padding: 23.08rpx 23.08rpx 30.77rpx; gap: 11.54rpx; flex-direction: column; border-radius: 30.77rpx; background: #fff8f1; }
.heatmap-header { display: flex; width: 100%; height: 34.62rpx; align-items: center; justify-content: space-between; }
.heatmap-title { color: #27221e; font-size: 23.08rpx; font-weight: 600; line-height: 34.62rpx; }
.heatmap-days { color: #b45309; font-size: 23.08rpx; line-height: 34.62rpx; }
.heatmap-calendar { display: flex; width: 100%; gap: 7.69rpx; flex-direction: column; }
.heatmap-months { display: flex; width: 100%; height: 26.92rpx; gap: 11.54rpx; align-items: center; }
.weekday-spacer { width: 19.23rpx; height: 26.92rpx; flex: none; }
.heatmap-month-track,.heatmap-grid-track { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: space-between; }
.heatmap-month-track { height: 26.92rpx; }
.heatmap-month { position: relative; width: 19.23rpx; height: 26.92rpx; flex: none; }
.heatmap-month text { position: absolute; top: 0; left: 0; width: 38.46rpx; height: 26.92rpx; color: #9ca3af; font-size: 19.23rpx; font-weight: 400; line-height: 26.92rpx; text-align: left; white-space: nowrap; }
.heatmap-body { display: flex; width: 100%; height: 192.31rpx; gap: 11.54rpx; align-items: center; }
.weekday-labels,.heatmap-week { display: flex; flex-direction: column; align-items: center; }
.weekday-labels { width: 19.23rpx; flex: none; gap: 9.62rpx; color: #9ca3af; font-size: 19.23rpx; font-weight: 400; line-height: 19.23rpx; }
.weekday-labels text { width: 19.23rpx; height: 19.23rpx; }
.heatmap-grid-track { height: 192.31rpx; }
.heatmap-week { width: 19.23rpx; height: 192.31rpx; flex: none; gap: 9.62rpx; }
.heatmap-cell { width: 19.23rpx; height: 19.23rpx; flex: none; border-radius: 5.77rpx; background: #f0f1f2; }
.heat-level-1 { background: #fff0e2; }.heat-level-2 { background: #ffd9b8; }.heat-level-3 { background: #ffbc83; }.heat-level-4 { background: #ff9f52; }

.pigeon-summary { display: flex; box-sizing: border-box; width: 100%; min-height: 0; flex: 1; padding: 23.08rpx 23.08rpx 30.77rpx; gap: 15.38rpx; flex-direction: column; border-radius: 30.77rpx; background: #fff8ec; }
.pigeon-summary-header { display: flex; width: 100%; height: 34.62rpx; flex: none; align-items: center; justify-content: space-between; }
.pigeon-summary-title { color: #4a2a16; font-size: 23.08rpx; font-weight: 600; line-height: 34.62rpx; }
.pigeon-summary-total { color: #9a7255; font-size: 23.08rpx; font-weight: 400; line-height: 34.62rpx; }
.pigeon-summary-content { display: flex; min-height: 0; flex: 1; gap: 15.38rpx; align-items: center; }
.pigeon-copy { display: flex; min-width: 0; height: 100%; flex: 1; gap: 11.54rpx; flex-direction: column; justify-content: center; }
.pigeon-label { color: #c94f00; font-size: 23.08rpx; font-weight: 700; line-height: 34.62rpx; }
.pigeon-description { display: flex; flex-direction: column; color: #9a7255; font-size: 19.23rpx; font-weight: 500; line-height: 28.85rpx; }
.pigeon-description-line { display: block; height: 28.85rpx; line-height: 28.85rpx; }
.pigeon-ring { display: flex; box-sizing: border-box; width: 215.38rpx; height: 215.38rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; box-shadow: 0 7.69rpx 23.08rpx rgba(184,74,0,.1); }
.pigeon-ring-inner { display: flex; width: 138.46rpx; height: 138.46rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.95); }
.pigeon-rate { color: #b84a00; font-size: 46.15rpx; font-weight: 700; line-height: 57.69rpx; }
.pigeon-rate-label { color: #9a7255; font-size: 19.23rpx; font-weight: 600; line-height: 28.85rpx; }

.podium-row { display: flex; width: 100%; height: 238.46rpx; margin-top: 15.38rpx; gap: 15.38rpx; align-items: flex-end; }
.podium-card { display: flex; box-sizing: border-box; height: 215.38rpx; padding: 15.38rpx 15.38rpx 11.54rpx; gap: 3.85rpx; min-width: 0; flex: 1; flex-direction: column; align-items: center; border-radius: 30.77rpx; background: linear-gradient(180deg,#fff3e0,#fff); box-shadow: 0 9.62rpx 30.77rpx rgba(0,0,0,.05); }
.podium-rank-2 { height: 238.46rpx; justify-content: center; background: linear-gradient(180deg,#ffe0b2,#fff3e0); }
.podium-avatar-wrap { position: relative; width: 80.77rpx; height: 103.85rpx; flex: none; }
.podium-avatar { box-sizing: border-box; width: 80.77rpx; height: 80.77rpx; border: 3.85rpx solid #ffe0b2; border-radius: 50%; background: #fff; }
.rank-badge { position: absolute; bottom: 0; left: 17.31rpx; display: flex; box-sizing: border-box; width: 46.15rpx; height: 46.15rpx; align-items: center; justify-content: center; border: 3.85rpx solid #fff; border-radius: 50%; background: #ffe0b2; color: #4b5563; font-size: 23.08rpx; font-weight: 700; }
.podium-rank-2 .podium-avatar { border-color: #ffb74d; }
.podium-rank-2 .rank-badge { border-color: #fff3e0; background: #ffb74d; color: #000; }
.podium-rank-4 .rank-badge { background: #fff3e0; }
.podium-name { width: 100%; overflow: hidden; color: #000; font-size: 23.08rpx; font-weight: 600; line-height: 30.77rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.podium-value { display: flex; height: 42.31rpx; gap: 5.77rpx; align-items: center; justify-content: center; }
.podium-number { color: #ff9800; font-size: 38.46rpx; font-weight: 700; }.podium-unit,.podium-prefix { color: #4b5563; font-size: 19.23rpx; }.podium-prefix,.podium-prefix ~ .podium-unit { font-weight: 500; }

.ranking-list { display: flex; margin-top: 15.38rpx; padding-bottom: 15.38rpx; gap: 7.69rpx; flex-direction: column; }
.ranking-row { display: flex; box-sizing: border-box; width: 100%; height: 76.92rpx; padding: 7.69rpx 15.38rpx; gap: 15.38rpx; align-items: center; border-radius: 23.08rpx; background: #fff; box-shadow: 0 3.85rpx 19.23rpx rgba(0,0,0,.08); }
.ranking-row-rank { width: 30.77rpx; color: #6b7280; font-size: 23.08rpx; font-weight: 700; text-align: center; }
.ranking-row-avatar { width: 61.54rpx; height: 61.54rpx; flex: none; border-radius: 50%; background: #f5f5f5; }
.ranking-row-main { display: flex; min-width: 0; height: 61.54rpx; flex: 1; gap: 7.69rpx; flex-direction: column; justify-content: center; }
.ranking-row-name { overflow: hidden; color: #111827; font-size: 23.08rpx; font-weight: 600; line-height: 30.77rpx; text-overflow: ellipsis; white-space: nowrap; }
.ranking-progress { width: 100%; height: 9.62rpx; overflow: hidden; border-radius: 960.58rpx; background: #f5f5f5; }
.ranking-progress-fill { height: 100%; border-radius: 960.58rpx; background: #ffb74d; }
.ranking-row:nth-child(2) .ranking-progress-fill,.ranking-row:nth-child(3) .ranking-progress-fill { background: #ffd08a; }
.ranking-row:nth-child(n + 4) .ranking-progress-fill { background: #ffe0b2; }
.ranking-row-value { width: 107.69rpx; color: #ff9800; font-size: 23.08rpx; font-weight: 700; text-align: right; }
.pigeon-row-value { display: flex; width: 123.08rpx; gap: 3.85rpx; align-items: center; justify-content: flex-end; color: #6b7280; font-size: 19.23rpx; }.pigeon-row-number { color: #ff9800; font-size: 26.92rpx; font-weight: 700; }
.ranking-empty { display: flex; min-height: 451.92rpx; flex: 1; gap: 26.92rpx; flex-direction: column; align-items: center; justify-content: center; color: #c0c4cc; font-size: 26.92rpx; font-weight: 500; }
.ranking-empty-image { width: 365.38rpx; height: 365.38rpx; }
