/* ── 大卡片毛玻璃底部 ── */
.glass-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  box-sizing: border-box;
  /* 微信渲染会向下取整子项 rpx；31.4rpx 在常见视口恢复原型 16px 的实际边距。 */
  padding: 31.4rpx;
  z-index: 3;
  overflow: hidden;
  border-bottom-left-radius: 30.77rpx;
  border-bottom-right-radius: 30.77rpx;
}

/* 模糊视口直接挂在 large-card 上：只显示卡片底部信息区，最终由 large-card 裁切。 */
.glass-static-blur-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  border-bottom-left-radius: inherit;
  border-bottom-right-radius: inherit;
  pointer-events: none;
  background: rgba(31, 41, 55, 0.58);
}

/*
 * 毛玻璃使用服务端预渲染的单张静态图。stage 只负责按整张卡片坐标对齐，
 * glass-bottom 负责把它裁切在卡片内部并保留底部圆角。
 */
.glass-static-blur-stage {
  position: absolute;
  left: 0;
  bottom: 0;
  /* 与整张卡片底边对齐，信息栏高度变化时不再依赖硬编码 top。 */
  width: 530.77rpx;
  height: 707.69rpx;
  overflow: visible;
  pointer-events: none;
}

.glass-static-blur-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 530.77rpx;
  height: 707.69rpx;
  display: block;
}

.glass-tint-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  border-bottom-left-radius: 30.77rpx;
  border-bottom-right-radius: 30.77rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.30) 100%);
}

/* 原型中的黄色桌游大卡使用更深一档的 20% → 40% 信息栏遮罩。 */
.large-card--boardgame-boardgame-default .glass-tint-layer {
