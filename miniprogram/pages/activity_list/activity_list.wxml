<template name="home-skeleton-shape">
  <view class="skeleton-block {{shape}}" aria-hidden="true">
    <view class="skeleton-shimmer {{running ? 'skeleton-shimmer--running' : ''}}"></view>
  </view>
</template>
<template name="home-card-skeleton">
  <view class="card-skeleton card-skeleton--{{size}} {{revealed ? 'card-skeleton--revealed' : ''}}" aria-hidden="{{revealed ? true : false}}" aria-label="{{failed ? '卡片加载失败' : '卡片加载中'}}">
    <template wx:if="{{size === 'large'}}" is="home-skeleton-shape" data="{{shape: 'skeleton-date', running: running && !failed}}" />
    <template is="home-skeleton-shape" data="{{shape: size === 'large' ? 'skeleton-large' : 'skeleton-small', running: running && !failed}}" />
    <view wx:if="{{failed}}" class="home-card-retry home-card-retry--{{size}}" role="button" aria-label="重新加载这张卡片" catchtap="onRetryHomeCard" data-group="{{group}}" data-activity-id="{{activityId}}">
      <text>加载失败，点击重试</text>
    </view>
    <block wx:if="{{size === 'small'}}">
      <template is="home-skeleton-shape" data="{{shape: 'skeleton-name', running: running && !failed}}" />
      <template is="home-skeleton-shape" data="{{shape: 'skeleton-time', running: running && !failed}}" />
    </block>
  </view>
</template>
<!-- 页面容器 -->
<view class="page-wrap">
  <!-- 原型装饰层：脱离滚动文档流，固定沉在首页内容下方。 -->
  <image class="page-watermark dragon-watermark dragon-watermark--absolute" src="../../images/activity-home-logo.png" mode="aspectFit" />

  <scroll-view
    class="main-scroll"
    type="list"
    scroll-y="{{true}}"
    show-scrollbar="false"
    bindscroll="onMainScroll"
    style="height: 100vh"
    refresher-enabled="{{true}}"
    refresher-threshold="{{80}}"
    refresher-default-style="none"
    refresher-background="#ffffff"
    refresher-triggered="{{mainRefresherTriggered}}"
    bindrefresherpulling="onMainRefresherPulling"
    bindrefresherrestore="onMainRefresherRestore"
    bindrefresherrefresh="onMainRefresherRefresh"
  >
    <view slot="refresher" class="main-refresher-slot">
      <text class="main-refresher-hint">{{mainRefresherHint}}</text>
    </view>
    <!-- 自定义透明顶部栏（随页面滚动） -->
    <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
      <view class="navbar-inner">
        <text class="navbar-title">龙城预约系统</text>
      </view>
    </view>

    <block>

      <!-- The shell paints before the activity request resolves. -->
      <view wx:if="{{homeListLoading}}" class="home-loading-shell">
        <view class="group-section">
          <view class="group-header"><template is="home-skeleton-shape" data="{{shape: 'skeleton-heading', running: skeletonShimmerRunning}}" /></view>
          <view class="skeleton-initial-row skeleton-initial-row--large">
            <view wx:for="{{[0, 1]}}" wx:key="*this" class="skeleton-initial-large"><template is="home-card-skeleton" data="{{size: 'large', running: skeletonShimmerRunning}}" /></view>
          </view>
        </view>
        <view class="group-section">
          <view class="group-header"><template is="home-skeleton-shape" data="{{shape: 'skeleton-heading', running: skeletonShimmerRunning}}" /></view>
          <view class="skeleton-initial-row skeleton-initial-row--small">
            <view wx:for="{{[0, 1]}}" wx:key="*this" class="skeleton-initial-small"><template is="home-card-skeleton" data="{{size: 'small', running: skeletonShimmerRunning}}" /></view>
          </view>
        </view>
      </view>

      <!-- ── 我参与的 ── -->
      <view wx:if="{{groupSectionVisibility.joined}}" class="group-section joined-group-section">
        <view class="group-header">
          <text class="group-title">我参与的</text>
        </view>
        <swiper
          id="qaJoinedCardSwiper"
          class="cards-swiper large-cards-swiper"
          current="{{focusedCardIndex.joined}}"
          duration="300"
          easing-function="easeOutCubic"
          previous-margin="38.46rpx"
          next-margin="157.69rpx"
          cache-extent="1"
          data-group="joined"
          bindchange="onGroupSwiperChange"
        >
          <swiper-item
            wx:for="{{groupedActivities.joined}}"
            wx:key="_id"
            class="large-card-slide"
          >
            <view class="home-card-slot home-card-slot--large" data-group="joined" data-activity-id="{{item._id}}">
              <template is="home-card-skeleton" data="{{size: 'large', revealed: item._homeMediaReady && item._homeSlotEntered, running: skeletonShimmerRunning && !item._homeMediaError && !(item._homeMediaReady && item._homeSlotEntered), failed: item._homeMediaError, group: 'joined', activityId: item._id}}" />
            <view
              class="large-card-wrap home-card-entrance home-card-entrance--{{!(item._homeMediaReady && item._homeSlotEntered) ? 'pending' : (item._id == createdCardEntranceId ? createdCardEntranceState : 'entered')}}"
            >
              <text class="card-datetime-label">{{item.cardDateTimeLabel || item.startTime}}</text>
              <open-container
                class="large-card-transition"
                closed-color="transparent"
                closed-elevation="0"
                closed-border-radius="16"
                open-elevation="0"
                open-border-radius="0"
                transition-type="fadeThrough"
                transition-duration="320"
                bind:tap="showDetail"
                data-activity="{{item}}"
              >
                <!-- 大卡片 -->
                <view class="large-card large-card--{{item.activityType}}-{{item.activityStyleKey}}">
                <image
                  wx:if="{{item._homeCoverSrc}}"
                  class="card-image-bg"
                  src="{{item._homeCoverSrc}}"
                  data-media-src="{{item._homeCoverSrc}}"
                  mode="aspectFill"
                  lazy-load="{{false}}"
                  bindload="onCardBgLoaded"
                  binderror="onCardBgError"
                  data-group="joined"
                  data-card-size="large"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.largeCardBgImageUrl}}"
                />
                <video
                  wx:if="{{item.bgVideoUrl}}"
                  id="vid-joined-{{index}}"
                  class="card-video-bg"
                  src="{{item.bgVideoUrl}}"
                  objectFit="cover"
                  autoplay="{{focusedCardIndex.joined === index}}"
                  loop="{{true}}"
                  muted="{{true}}"
                  controls="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  enable-progress-gesture="{{false}}"
                  bindloadedmetadata="onCardVideoLoaded"
                  binderror="onCardVideoError"
                  bindwaiting="onCardVideoWaiting"
                  data-group="joined"
                  data-card-size="large"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.bgVideoUrl}}"
                />
                <!-- 头像群（最近 3 人，从下往上递减：TL > TR > Middle） -->
                <view wx:if="{{item.showAvatarCluster}}" class="avatar-cluster-large">
                  <view wx:if="{{item.cardAvatars.length >= 1}}" class="avatar-tl">
                    <image
                      class="cluster-avatar"
                      src="{{item.cardAvatars[item.cardAvatars.length - 1].url}}"
                      mode="aspectFill"
                      binderror="onAvatarError"
                      data-index="{{item.cardAvatars.length - 1}}"
                      data-activity-id="{{item._id}}"
                    />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 2}}" class="avatar-tr">
                    <image
                      class="cluster-avatar"
                      src="{{item.cardAvatars[item.cardAvatars.length - 2].url}}"
                      mode="aspectFill"
                    />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 3}}" class="avatar-mid">
                    <image
                      class="cluster-avatar"
                      src="{{item.cardAvatars[item.cardAvatars.length - 3].url}}"
                      mode="aspectFill"
                    />
                  </view>
                </view>
                <!-- 卡片内部底部毛玻璃：模糊层与信息层共用同一个边界，避免顶部出现接缝 -->
                <view class="glass-bottom">
                  <view class="glass-static-blur-layer">
                    <view wx:if="{{item._homeGlassSrc}}" class="glass-static-blur-stage">
                      <!-- 服务端已完成镜像扩边和单次模糊；真机只展示静态位图，不运行实时滤镜。 -->
                      <image
                        class="glass-static-blur-image"
                        src="{{item._homeGlassSrc}}"
                        data-media-src="{{item._homeGlassSrc}}"
                        mode="aspectFill"
                        data-group="joined"
                        bindload="onCardGlassLoaded"
                        binderror="onCardGlassError"
                        data-activity-id="{{item._id}}"
                        data-url="{{item.largeCardGlassImageUrl}}"
                      />
                    </view>
                  </view>
                  <view class="glass-tint-layer"></view>
                  <view class="glass-content">
                    <text class="glass-name">{{item.name}}</text>
                    <text class="glass-remark">{{item.remark || ''}}</text>
                    <view class="glass-meta-row">
                      <view wx:if="{{item.locationName}}" class="glass-meta-item">
                        <image class="glass-meta-icon-img" src="/images/icon-home-card-location.svg" mode="aspectFit" />
                        <text class="glass-meta-text">{{item.locationName}}</text>
                      </view>
                      <view class="glass-meta-item">
                        <image class="glass-meta-icon-img" src="/images/icon-home-card-people.svg" mode="aspectFit" />
                        <text class="glass-meta-text" wx:if="{{item.maxParticipants != null}}">{{item.participantCount}}/{{item.maxParticipants}} 人</text>
                        <text class="glass-meta-text" wx:elif="{{item.participantCount > 0}}">{{item.participantCount}} 人</text>
                        <text class="glass-meta-text" wx:else>0 人</text>
                      </view>
                    </view>
                  </view>
                </view>
                </view>
              </open-container>
            </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- ── 接受报名 ── -->
      <view wx:if="{{groupSectionVisibility.accepting}}" class="group-section">
        <view class="group-header">
          <text class="group-title">接受报名</text>
        </view>
        <swiper
          id="qaAcceptingCardSwiper"
          class="cards-swiper small-cards-swiper"
          current="{{focusedCardIndex.accepting}}"
          duration="300"
          easing-function="easeOutCubic"
          previous-margin="26.92rpx"
          next-margin="353.85rpx"
          cache-extent="1"
          data-group="accepting"
          bindchange="onGroupSwiperChange"
        >
          <swiper-item wx:for="{{groupedActivities.accepting}}" wx:key="_id" class="small-card-slide">
            <view class="home-card-slot home-card-slot--small" data-group="accepting" data-activity-id="{{item._id}}">
              <template is="home-card-skeleton" data="{{size: 'small', revealed: item._homeMediaReady && item._homeSlotEntered, running: skeletonShimmerRunning && !item._homeMediaError && !(item._homeMediaReady && item._homeSlotEntered), failed: item._homeMediaError, group: 'accepting', activityId: item._id}}" />
            <view
              class="small-card-layout home-card-entrance home-card-entrance--{{!(item._homeMediaReady && item._homeSlotEntered) ? 'pending' : (item._id == createdCardEntranceId ? createdCardEntranceState : 'entered')}}"
            >
              <view class="small-card-shadow" aria-hidden="true"></view>
              <open-container
              class="small-card-wrap"
              closed-color="transparent"
              closed-elevation="0"
              closed-border-radius="0"
              open-elevation="0"
              open-border-radius="0"
              transition-type="fadeThrough"
              transition-duration="320"
              bind:tap="showDetail"
              data-activity="{{item}}"
            >
              <view class="small-card-content">
                <view class="small-card">
                <image
                  wx:if="{{item._homeCoverSrc}}"
                  class="card-image-bg"
                  src="{{item._homeCoverSrc}}"
                  data-media-src="{{item._homeCoverSrc}}"
                  mode="aspectFill"
                  lazy-load="{{false}}"
                  bindload="onCardBgLoaded"
                  binderror="onCardBgError"
                  data-group="accepting"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.smallCardBgImageUrl}}"
                />
                <video
                  wx:if="{{item.bgVideoUrl}}"
                  id="vid-accepting-{{index}}"
                  class="card-video-bg"
                  src="{{item.bgVideoUrl}}"
                  objectFit="cover"
                  autoplay="{{focusedCardIndex.accepting === index}}"
                  loop="{{true}}"
                  muted="{{true}}"
                  controls="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  enable-progress-gesture="{{false}}"
                  bindloadedmetadata="onCardVideoLoaded"
                  binderror="onCardVideoError"
                  bindwaiting="onCardVideoWaiting"
                  data-group="accepting"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.bgVideoUrl}}"
                />
                <view wx:if="{{item.showAvatarCluster}}" class="avatar-cluster-small">
                  <view wx:if="{{item.cardAvatars.length >= 1}}" class="avatar-tl-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 1].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 2}}" class="avatar-tr-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 2].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 3}}" class="avatar-mid-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 3].url}}" mode="aspectFill" />
                  </view>
                </view>
                </view>
                <view class="small-card-info">
                  <text class="small-card-name">{{item.name}}</text>
                  <text class="small-card-time">{{item.smallCardTimeLabel || item.startTime}}</text>
                </view>
              </view>
              </open-container>
            </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- ── 未开始 ── -->
      <view wx:if="{{groupSectionVisibility.notStarted}}" class="group-section">
        <view class="group-header">
          <text class="group-title">未开始</text>
        </view>
        <swiper
          id="qaNotStartedCardSwiper"
          class="cards-swiper small-cards-swiper"
          current="{{focusedCardIndex.notStarted}}"
          duration="300"
          easing-function="easeOutCubic"
          previous-margin="26.92rpx"
          next-margin="353.85rpx"
          cache-extent="1"
          data-group="notStarted"
          bindchange="onGroupSwiperChange"
        >
          <swiper-item wx:for="{{groupedActivities.notStarted}}" wx:key="_id" class="small-card-slide">
            <view class="home-card-slot home-card-slot--small" data-group="notStarted" data-activity-id="{{item._id}}">
              <template is="home-card-skeleton" data="{{size: 'small', revealed: item._homeMediaReady && item._homeSlotEntered, running: skeletonShimmerRunning && !item._homeMediaError && !(item._homeMediaReady && item._homeSlotEntered), failed: item._homeMediaError, group: 'notStarted', activityId: item._id}}" />
            <view
              class="small-card-layout home-card-entrance home-card-entrance--{{!(item._homeMediaReady && item._homeSlotEntered) ? 'pending' : (item._id == createdCardEntranceId ? createdCardEntranceState : 'entered')}}"
            >
              <view class="small-card-shadow" aria-hidden="true"></view>
              <open-container
              class="small-card-wrap"
              closed-color="transparent"
              closed-elevation="0"
              closed-border-radius="0"
              open-elevation="0"
              open-border-radius="0"
              transition-type="fadeThrough"
              transition-duration="320"
              bind:tap="showDetail"
              data-activity="{{item}}"
            >
              <view class="small-card-content">
                <view class="small-card">
                <image
                  wx:if="{{item._homeCoverSrc}}"
                  class="card-image-bg"
                  src="{{item._homeCoverSrc}}"
                  data-media-src="{{item._homeCoverSrc}}"
                  mode="aspectFill"
                  lazy-load="{{false}}"
                  bindload="onCardBgLoaded"
                  binderror="onCardBgError"
                  data-group="notStarted"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.smallCardBgImageUrl}}"
                />
                <video
                  wx:if="{{item.bgVideoUrl}}"
                  id="vid-notStarted-{{index}}"
                  class="card-video-bg"
                  src="{{item.bgVideoUrl}}"
                  objectFit="cover"
                  autoplay="{{focusedCardIndex.notStarted === index}}"
                  loop="{{true}}"
                  muted="{{true}}"
                  controls="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  enable-progress-gesture="{{false}}"
                  bindloadedmetadata="onCardVideoLoaded"
                  binderror="onCardVideoError"
                  bindwaiting="onCardVideoWaiting"
                  data-group="notStarted"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.bgVideoUrl}}"
                />
                <view wx:if="{{item.showAvatarCluster}}" class="avatar-cluster-small">
                  <view wx:if="{{item.cardAvatars.length >= 1}}" class="avatar-tl-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 1].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 2}}" class="avatar-tr-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 2].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 3}}" class="avatar-mid-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 3].url}}" mode="aspectFill" />
                  </view>
                </view>
                </view>
                <view class="small-card-info">
                  <text class="small-card-name">{{item.name}}</text>
                  <text class="small-card-time">{{item.smallCardTimeLabel || item.startTime}}</text>
                </view>
              </view>
              </open-container>
            </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- ── 已结束 ── -->
      <view wx:if="{{groupSectionVisibility.ended}}" class="group-section ended-section">
        <view class="group-header">
          <text class="group-title">已结束</text>
        </view>
        <swiper
          id="qaEndedCardSwiper"
          class="cards-swiper small-cards-swiper"
          current="{{focusedCardIndex.ended}}"
          duration="300"
          easing-function="easeOutCubic"
          previous-margin="26.92rpx"
          next-margin="353.85rpx"
          cache-extent="1"
          data-group="ended"
          bindchange="onGroupSwiperChange"
        >
          <swiper-item wx:for="{{groupedActivities.ended}}" wx:key="_id" class="small-card-slide">
            <view class="home-card-slot home-card-slot--small" data-group="ended" data-activity-id="{{item._id}}">
              <template is="home-card-skeleton" data="{{size: 'small', revealed: item._homeMediaReady && item._homeSlotEntered, running: skeletonShimmerRunning && !item._homeMediaError && !(item._homeMediaReady && item._homeSlotEntered), failed: item._homeMediaError, group: 'ended', activityId: item._id}}" />
            <view
              class="small-card-layout home-card-entrance home-card-entrance--{{!(item._homeMediaReady && item._homeSlotEntered) ? 'pending' : (item._id == createdCardEntranceId ? createdCardEntranceState : 'entered')}}"
            >
              <view class="small-card-shadow" aria-hidden="true"></view>
              <open-container
              class="small-card-wrap"
              closed-color="transparent"
              closed-elevation="0"
              closed-border-radius="0"
              open-elevation="0"
              open-border-radius="0"
              transition-type="fadeThrough"
              transition-duration="320"
              bind:tap="showDetail"
              data-activity="{{item}}"
            >
              <view class="small-card-content">
                <view class="small-card">
                <image
                  wx:if="{{item._homeCoverSrc}}"
                  class="card-image-bg"
                  src="{{item._homeCoverSrc}}"
                  data-media-src="{{item._homeCoverSrc}}"
                  mode="aspectFill"
                  lazy-load="{{false}}"
                  bindload="onCardBgLoaded"
                  binderror="onCardBgError"
                  data-group="ended"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.smallCardBgImageUrl}}"
                />
                <video
                  wx:if="{{item.bgVideoUrl}}"
                  id="vid-ended-{{index}}"
                  class="card-video-bg"
                  src="{{item.bgVideoUrl}}"
                  objectFit="cover"
                  autoplay="{{focusedCardIndex.ended === index}}"
                  loop="{{true}}"
                  muted="{{true}}"
                  controls="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  enable-progress-gesture="{{false}}"
                  bindloadedmetadata="onCardVideoLoaded"
                  binderror="onCardVideoError"
                  bindwaiting="onCardVideoWaiting"
                  data-group="ended"
                  data-card-size="small"
                  data-activity-id="{{item._id}}"
                  data-activity-name="{{item.name}}"
                  data-url="{{item.bgVideoUrl}}"
                />
                <view wx:if="{{item.showAvatarCluster}}" class="avatar-cluster-small">
                  <view wx:if="{{item.cardAvatars.length >= 1}}" class="avatar-tl-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 1].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 2}}" class="avatar-tr-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 2].url}}" mode="aspectFill" />
                  </view>
                  <view wx:if="{{item.cardAvatars.length >= 3}}" class="avatar-mid-sm">
                    <image class="cluster-avatar" src="{{item.cardAvatars[item.cardAvatars.length - 3].url}}" mode="aspectFill" />
                  </view>
                </view>
                </view>
                <view class="small-card-info">
                  <text class="small-card-name">{{item.name}}</text>
                  <text class="small-card-time">{{item.smallCardTimeLabel || item.startTime}}</text>
                </view>
              </view>
              </open-container>
            </view>
            </view>
          </swiper-item>
          <swiper-item wx:if="{{endedHasMore && groupedActivities.ended.length > 0}}" class="small-card-slide">
            <view class="small-card-wrap ended-more-strip">
              <view class="ended-more-card" catchtap="onEndedHorizontalLoadMore">
                <text class="ended-more-text">{{endedLoadingMore ? '加载中…' : '点击加载更多'}}</text>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- 底部占位与悬浮 Tab 高度一致，避免内容被遮挡 -->
      <view style="height: calc(100rpx + {{bottomSafeAreaRpx}}rpx)"></view>
    </block>
  </scroll-view>

  <!-- 底部 Tab 由 custom-tab-bar 组件统一渲染，此处无需内联 -->

  <page-container
    wx:if="{{createFormContainerRendered}}"
    id="qaActivityCreateContainer"
    show="{{showCreateForm}}"
    position="bottom"
    overlay="{{true}}"
    round="{{false}}"
    duration="240"
    close-on-slide-down="{{false}}"
    overlay-style="background: rgba(23, 24, 20, 0.4);"
    custom-style="height: 100%; background: transparent; border-radius: 0; overflow: hidden;"
    bind:clickoverlay="closeCreateForm"
    bind:afterleave="onCreateFormAfterLeave"
  >
    <activity-form-sheet
      id="qaActivityCreateForm"
      style="display: block; width: 100%; height: 100%;"
      visible="{{showCreateForm}}"
      route-embedded="{{true}}"
      mode="create"
      submitting="{{createFormSubmitting}}"
      bindclose="closeCreateForm"
      bindsubmit="submitCreateActivity"
    />
  </page-container>

</view>

<create-access-dialog id="create-access-dialog" />
