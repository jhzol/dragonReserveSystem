<view class="page-wrap">
  <view wx:if="{{loading || detailSkeletonLeaving}}" id="qaActivityDetailSkeleton" class="detail-skeleton-screen {{detailSkeletonLeaving ? 'detail-skeleton-screen--leaving' : ''}}" aria-label="活动详情加载中">
    <view class="detail-skeleton-hero">
      <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
        <view class="navbar-inner">
          <view class="nav-back" hover-class="nav-back-hover" hover-stay-time="80" bindtap="onTapBack">
            <image class="nav-back-icon" src="/images/activity-detail-chevron-left.svg" mode="aspectFit" />
          </view>
          <view class="nav-placeholder"></view>
        </view>
      </view>

      <view class="detail-skeleton-hero-copy">
        <view class="detail-skeleton-status-row">
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-status-pill"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-hero-meta"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
        </view>
        <view class="detail-skeleton-title-group">
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-title-primary"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-title-secondary"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
        </view>
        <view class="detail-skeleton-remark-row">
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-remark"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
          <view class="detail-skeleton-block detail-skeleton-block-dark detail-skeleton-expand"><view class="detail-skeleton-shimmer detail-skeleton-shimmer-dark"></view></view>
        </view>
      </view>
    </view>

    <view class="detail-skeleton-panel">
      <view class="detail-skeleton-block detail-skeleton-section-title"><view class="detail-skeleton-shimmer"></view></view>

      <view class="detail-skeleton-facts-row">
        <view class="detail-skeleton-fact detail-skeleton-fact-date">
          <view class="detail-skeleton-block detail-skeleton-fact-label"><view class="detail-skeleton-shimmer"></view></view>
          <view class="detail-skeleton-block detail-skeleton-fact-value detail-skeleton-fact-value-date"><view class="detail-skeleton-shimmer"></view></view>
        </view>
        <view class="detail-skeleton-divider"></view>
        <view class="detail-skeleton-fact detail-skeleton-fact-time">
          <view class="detail-skeleton-block detail-skeleton-fact-label"><view class="detail-skeleton-shimmer"></view></view>
          <view class="detail-skeleton-block detail-skeleton-fact-value detail-skeleton-time-value"><view class="detail-skeleton-shimmer"></view></view>
        </view>
        <view class="detail-skeleton-divider"></view>
        <view class="detail-skeleton-fact detail-skeleton-fact-people">
          <view class="detail-skeleton-block detail-skeleton-fact-label detail-skeleton-people-label"><view class="detail-skeleton-shimmer"></view></view>
          <view class="detail-skeleton-block detail-skeleton-fact-value detail-skeleton-fact-value-people"><view class="detail-skeleton-shimmer"></view></view>
        </view>
      </view>

      <view class="detail-skeleton-location-card">
        <view class="detail-skeleton-block detail-skeleton-map"><view class="detail-skeleton-shimmer"></view></view>
        <view class="detail-skeleton-location-meta">
          <view class="detail-skeleton-location-copy">
            <view class="detail-skeleton-block detail-skeleton-location-name"><view class="detail-skeleton-shimmer"></view></view>
            <view class="detail-skeleton-block detail-skeleton-location-address"><view class="detail-skeleton-shimmer"></view></view>
          </view>
          <view class="detail-skeleton-block detail-skeleton-navigation"><view class="detail-skeleton-shimmer"></view></view>
        </view>
      </view>

      <view class="detail-skeleton-weather-card">
        <view class="detail-skeleton-weather-content">
          <view class="detail-skeleton-weather-summary">
            <view class="detail-skeleton-block detail-skeleton-weather-icon"><view class="detail-skeleton-shimmer"></view></view>
            <view class="detail-skeleton-temperature-copy">
              <view class="detail-skeleton-block detail-skeleton-temperature"><view class="detail-skeleton-shimmer"></view></view>
              <view class="detail-skeleton-block detail-skeleton-condition"><view class="detail-skeleton-shimmer"></view></view>
            </view>
          </view>
          <view class="detail-skeleton-weather-divider"></view>
          <view class="detail-skeleton-weather-metrics">
            <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="detail-skeleton-weather-metric">
              <view class="detail-skeleton-block detail-skeleton-metric-icon"><view class="detail-skeleton-shimmer"></view></view>
              <view class="detail-skeleton-block detail-skeleton-metric-value"><view class="detail-skeleton-shimmer"></view></view>
              <view class="detail-skeleton-block detail-skeleton-metric-label"><view class="detail-skeleton-shimmer"></view></view>
            </view>
          </view>
        </view>
        <view class="detail-skeleton-weather-source">
          <view class="detail-skeleton-block detail-skeleton-source-text"><view class="detail-skeleton-shimmer"></view></view>
        </view>
      </view>
    </view>

    <view class="detail-skeleton-bottom-bar" style="height: calc(107.69rpx + {{safeBottomRpx}}rpx); padding-bottom: {{safeBottomRpx}}rpx">
      <view class="detail-skeleton-bottom-inner">
        <view class="detail-skeleton-block detail-skeleton-share-button"><view class="detail-skeleton-shimmer"></view></view>
        <view class="detail-skeleton-block detail-skeleton-primary-button"><view class="detail-skeleton-shimmer"></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{activity || loadError}}" class="detail-content-layer {{activity && !detailContentVisible ? 'detail-content-layer--hidden' : 'detail-content-layer--visible'}}">
  <view
    class="main-scroll"
    style="height: calc(100vh - {{bottomBarHeightRpx}}rpx)"
  >
    <view wx:if="{{loadError}}" class="state-block state-block-full">
      <text class="state-text">{{loadError}}</text>
      <button class="retry-btn" bindtap="refreshDetail">重试</button>
    </view>

    <block wx:elif="{{activity}}">
      <view id="qaActivityDetailHero" class="immersive-hero">
        <image
          wx:if="{{activity.largeCardBgImageUrl && !activity.bgVideoUrl}}"
          class="hero-img"
          src="{{activity.largeCardBgImageUrl}}"
          mode="aspectFill"
        />
        <video
          wx:if="{{activity.bgVideoUrl}}"
          class="hero-video"
          src="{{activity.bgVideoUrl}}"
          objectFit="cover"
          autoplay="{{true}}"
          loop="{{true}}"
          muted="{{true}}"
          controls="{{false}}"
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
        />
        <view wx:if="{{activity.showAvatarCluster}}" class="hero-avatar-cluster">
          <view wx:if="{{heroCardAvatars.length >= 1}}" class="hero-avatar hero-avatar-tl">
            <image class="hero-cluster-avatar" src="{{heroCardAvatars[heroCardAvatars.length - 1].url}}" mode="aspectFill" />
          </view>
          <view wx:if="{{heroCardAvatars.length >= 2}}" class="hero-avatar hero-avatar-tr">
            <image class="hero-cluster-avatar" src="{{heroCardAvatars[heroCardAvatars.length - 2].url}}" mode="aspectFill" />
          </view>
          <view wx:if="{{heroCardAvatars.length >= 3}}" class="hero-avatar hero-avatar-mid">
            <image class="hero-cluster-avatar" src="{{heroCardAvatars[heroCardAvatars.length - 3].url}}" mode="aspectFill" />
          </view>
        </view>
        <view wx:if="{{!activity.largeCardBgImageUrl && !activity.bgVideoUrl}}" class="hero-placeholder"></view>
        <view class="hero-shade"></view>

        <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px">
          <view class="navbar-inner">
            <view class="nav-back" hover-class="nav-back-hover" hover-stay-time="80" bindtap="onTapBack">
              <image class="nav-back-icon" src="/images/activity-detail-chevron-left.svg" mode="aspectFit" />
            </view>
            <view class="nav-placeholder"></view>
          </view>
        </view>

        <view class="hero-copy">
          <view class="hero-status-row">
            <view class="status-pill {{detailStatusClass}}">{{activity.detailStatusTag}}</view>
            <text class="hero-meta">{{heroMetaText}}</text>
          </view>
          <text class="hero-title">{{activityTitleText}}</text>
          <view wx:if="{{activity.remark}}" class="hero-remark-row" bindtap="toggleRemark">
            <view
              class="hero-remark-viewport"
              style="height: {{remarkViewportHeightPx > 0 ? remarkViewportHeightPx + 'px' : '37.69rpx'}};"
            >
              <text
                class="hero-remark"
                overflow="ellipsis"
                max-lines="{{remarkExpanded ? 999 : 1}}"
              >{{activity.remark}}</text>
            </view>
            <view wx:if="{{remarkExpandable}}" class="remark-toggle">
              <view class="remark-toggle-label">
                <text class="remark-toggle-text {{remarkExpanded ? 'remark-toggle-text-out-up' : 'remark-toggle-text-active'}}">展开</text>
                <text class="remark-toggle-text {{remarkExpanded ? 'remark-toggle-text-active' : 'remark-toggle-text-out-down'}}">收起</text>
              </view>
              <view class="remark-chevron-rotator" style="transform: rotate({{remarkToggleRotationDeg}}deg);">
                <view class="remark-chevron"></view>
              </view>
            </view>
          </view>
        </view>

        <!-- 测量节点必须放在 hero-copy 外，避免 Skyline 将隐藏节点计入纵向 gap。 -->
        <text wx:if="{{activity.remark}}" class="hero-remark-measure">{{activity.remark}}</text>
        <text
          wx:if="{{activity.remark}}"
          class="hero-remark-full-measure"
          style="width: {{remarkTextWidthPx}}px;"
        >{{activity.remark}}</text>
        <view wx:if="{{activity.remark}}" class="remark-toggle-measure">
          <text class="remark-toggle-text">展开</text>
          <view class="remark-chevron-rotator">
            <view class="remark-chevron"></view>
          </view>
        </view>
      </view>

      <view id="qaActivityDetailContent" class="detail-panel">
        <view class="section-title-row">
          <text class="section-title">基本信息</text>
        </view>
        <view class="facts-row">
          <view class="fact-item">
            <text class="fact-label">日期</text>
            <text class="fact-value">{{activityDateText}}</text>
          </view>
          <view class="fact-divider"></view>
          <view class="fact-item fact-item-time">
            <text class="fact-label">时间</text>
            <text class="fact-value">{{activityTimeText}}</text>
          </view>
          <view class="fact-divider"></view>
          <view class="fact-item fact-participants" bindtap="openParticipantsDrawer">
            <text class="fact-label">报名人数</text>
            <view class="fact-participant-value">
              <text class="participant-current">{{participantCurrentText}}</text>
              <text wx:if="{{participantHasLimit}}" class="participant-separator">/</text>
              <text class="participant-limit">{{participantHasLimit ? participantMaxText + ' 人' : '人'}}</text>
              <image class="fact-chevron" src="/images/activity-detail-chevron-right.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view id="qaActivityLocationCard" class="location-card">
          <view class="map-preview">
            <map
              wx:if="{{locationMapAvailable}}"
              id="qaActivityLocationMap"
              class="location-map"
              latitude="{{locationMapLatitude}}"
              longitude="{{locationMapLongitude}}"
              scale="10"
              show-location="{{false}}"
              enable-scroll="{{false}}"
              enable-zoom="{{false}}"
              enable-rotate="{{false}}"
              enable-overlooking="{{false}}"
              markers="{{locationMapMarkers}}"
            />
            <view wx:else class="map-empty">
              <text class="map-empty-text">暂无地图信息</text>
            </view>
          </view>
          <view class="location-meta">
            <view class="location-copy">
              <view class="location-name-row">
                <text class="location-name">{{activity.locationName || '活动地点待定'}}</text>
                <text wx:if="{{locationDistanceText}}" class="location-distance">{{locationDistanceText}}</text>
              </view>
              <text class="location-address">{{activity.locationAddress || '暂无详细地址'}}</text>
            </view>
            <view class="navigate-button" hover-class="navigate-button-hover" bindtap="openLocation">
              <image class="navigate-icon" src="/images/icon-navigation.svg" mode="aspectFit" />
              <text>导航</text>
            </view>
          </view>
        </view>

        <view id="qaActivityWeatherCard" class="weather-card">
          <view wx:if="{{weather.loading}}" class="weather-unavailable">
            <text class="weather-unavailable-message">天气加载中…</text>
          </view>
          <view wx:elif="{{weather.available}}" class="weather-content">
            <view class="weather-summary">
              <view class="weather-icon-wrap">
                <image class="weather-icon" src="{{weather.icon}}" mode="aspectFit" />
              </view>
              <view class="weather-main-copy">
                <text class="weather-temperature">{{weather.temperature}}</text>
                <text class="weather-condition">{{weather.condition}}</text>
              </view>
            </view>
            <view class="weather-divider"></view>
            <view class="weather-metrics">
              <view class="weather-metric">
                <image class="weather-metric-icon" src="/images/weather-humidity.svg" mode="aspectFit" />
                <text class="weather-metric-value weather-metric-value-humidity">{{weather.humidity}}</text>
                <text class="weather-metric-label">空气湿度</text>
              </view>
              <view class="weather-metric">
                <image class="weather-metric-icon" src="/images/weather-wind.svg" mode="aspectFit" />
                <text class="weather-metric-value">{{weather.wind}}</text>
                <text class="weather-metric-label">风向风速</text>
              </view>
              <view class="weather-metric">
                <image class="weather-metric-icon" src="/images/weather-air-quality.svg" mode="aspectFit" />
                <text class="weather-metric-value">{{weather.airQuality}}</text>
                <text class="weather-metric-label">空气质量</text>
              </view>
            </view>
          </view>
          <view wx:else class="weather-unavailable">
            <text class="weather-unavailable-message">{{weather.message}}</text>
          </view>
          <view wx:if="{{weather.available}}" class="weather-attribution"><text class="weather-attribution-text">{{weather.attribution}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{activity}}" id="qaActivityDetailBottomBar" class="bottom-bar" style="padding-bottom: {{safeBottomRpx}}rpx">
    <view class="bottom-inner">
      <button
        class="bottom-icon-button bottom-icon-button-share {{(!canManageActivity || activity.status === '已结束') ? 'bottom-icon-button-wide' : ''}} {{sharePreviewLoading ? 'bottom-icon-button-disabled' : ''}}"
        open-type="{{sharePreviewLoading ? '' : 'share'}}"
        disabled="{{sharePreviewLoading}}"
        hover-class="bottom-button-hover"
      >
        <image class="bottom-button-icon" src="/images/icon-share.svg" mode="aspectFit" />
      </button>
      <button
        wx:if="{{canManageActivity && activity.status !== '已结束'}}"
        class="bottom-icon-button bottom-icon-button-edit"
        hover-class="bottom-button-hover"
        bindtap="openAdminEdit"
      >
        <image class="bottom-button-icon" src="/images/icon-edit.svg" mode="aspectFit" />
      </button>
      <button
        class="bottom-primary {{primaryActionType === 'cancel' ? 'bottom-primary-cancel' : ''}} {{primaryActionDisabled ? 'bottom-primary-disabled' : ''}}"
        disabled="{{primaryActionDisabled}}"
        hover-class="bottom-primary-hover"
        bindtap="onTapPrimaryAction"
      >{{primaryActionLabel}}</button>
    </view>
  </view>
  </view>

  <page-container
    wx:if="{{activityFormContainerRendered && canManageActivity && activity && activity.status !== '已结束'}}"
    id="qaActivityEditContainer"
    show="{{showActivityForm}}"
    position="bottom"
    overlay="{{true}}"
    round="{{false}}"
    duration="240"
    close-on-slide-down="{{false}}"
    overlay-style="background: rgba(23, 24, 20, 0.4);"
    custom-style="height: 100%; background: transparent; border-radius: 0; overflow: hidden;"
    bind:clickoverlay="closeActivityForm"
    bind:afterleave="onActivityFormAfterLeave"
  >
    <activity-form-sheet
      id="qaActivityFormSheet"
      style="display: block; width: 100%; height: 100%;"
      visible="{{showActivityForm}}"
      route-embedded="{{true}}"
      mode="edit"
      activity="{{activity}}"
      participant-count="{{activityParticipantCount}}"
      location-disabled="{{locationDisabled}}"
      submitting="{{activityFormSubmitting}}"
      bindclose="closeActivityForm"
      bindsubmit="submitActivityForm"
      bindcancelactivity="cancelActivityFromForm"
    />
  </page-container>

  <participants-drawer
    id="qaParticipantsDrawer"
    visible="{{showParticipantsDrawer}}"
    participants="{{participantDrawerList}}"
    participant-count="{{activityParticipantCount}}"
    checkin-count="{{activity.checkinCount || 0}}"
    max-participants="{{activity.maxParticipants}}"
    can-manage="{{canManageActivity}}"
    is-admin="{{isAdmin}}"
    safe-bottom-rpx="{{safeBottomRpx}}"
    bindclose="closeParticipantsDrawer"
    bindretrocheckin="adminRetroCheckin"
    bindcancelcheckin="adminCancelCheckin"
    bindremove="removeParticipant"
  />

  <view wx:if="{{showSignupProfileModal}}" class="signup-profile-overlay" catchtouchmove="stopPropagation">
    <view class="signup-profile-modal-bg" bindtap="closeSignupProfileModal"></view>
    <view class="signup-profile-modal-sheet" catchtap="stopPropagation" catchtouchmove="stopPropagation">
      <view class="signup-profile-modal-header">
        <text class="signup-profile-modal-title">修改个人资料</text>
        <text class="signup-profile-close-btn" bindtap="closeSignupProfileModal">×</text>
      </view>
      <scroll-view class="signup-profile-modal-body" type="list" scroll-y="{{true}}">
        <view class="signup-profile-hint">{{signupProfileHint}}</view>
        <view class="signup-profile-form-row">
          <view class="signup-profile-label">头像</view>
          <view class="signup-profile-avatar-wrap">
            <button class="signup-profile-avatar-btn" bindtap="onSignupProfileChooseAvatar">
              <image wx:if="{{signupProfileAvatarUrl}}" class="signup-profile-avatar-img" src="{{signupProfileAvatarUrl}}" mode="aspectFill" />
              <view wx:else class="signup-profile-avatar-placeholder">上传头像</view>
            </button>
          </view>
        </view>
        <view class="signup-profile-form-item">
          <view class="signup-profile-label">昵称</view>
          <input type="text" class="signup-profile-input" placeholder="请输入昵称" value="{{signupProfileNickname}}" bindinput="onSignupProfileNicknameInput" />
        </view>
      </scroll-view>
      <view class="signup-profile-modal-footer">
        <button class="signup-profile-btn signup-profile-btn-default" bindtap="closeSignupProfileModal">取消</button>
        <button class="signup-profile-btn signup-profile-btn-primary {{!signupProfileCanSubmit ? 'signup-profile-btn-disabled' : ''}}" bindtap="saveSignupProfile" disabled="{{!signupProfileCanSubmit}}">保存</button>
      </view>
    </view>
  </view>
</view>
