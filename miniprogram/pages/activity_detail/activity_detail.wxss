  flex-direction: column;
  gap: 23.08rpx;
}

.detail-skeleton-status-row {
  width: 100%;
  height: 53.85rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.detail-skeleton-title-group {
