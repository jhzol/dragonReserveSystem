  left: 0;
  z-index: 1200;
  overflow: hidden;
  background: #f5f5f5;
  opacity: 1;
  transition: opacity 280ms ease-out;
}

.detail-skeleton-screen--leaving {
  opacity: 0;
  pointer-events: none;
}

.detail-skeleton-hero {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 750rpx;
  overflow: hidden;
  background: #1a1d24;
}

