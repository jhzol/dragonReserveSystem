page {
  background: #f8fafc;
}

.tools-page {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  background: #f8fafc;
}

.tools-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.tools-watermark {
  position: absolute;
  top: -55.76923rpx;
  left: 336.53846rpx;
  z-index: 0;
  width: 621.15385rpx;
  height: 405.76923rpx;
  opacity: 0.8;
}

.tools-navbar {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  height: auto;
  padding-left: 38.46rpx;
  padding-right: 38.46rpx;
}

.tools-navbar-inner {
  display: flex;
  box-sizing: border-box;
  height: 84.61538rpx;
  align-items: center;
}

.tools-title {
  color: #000000;
  font-size: 46.15385rpx;
  font-weight: 600;
  line-height: 1.4166666667;
}

.tools-list {
  position: relative;
  z-index: 1;
  display: flex;
  box-sizing: border-box;
  margin-top: 53.84615rpx;
  padding: 0 38.46rpx;
  flex-direction: column;
  gap: 23.08rpx;
}

.tool-card {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 276.92rpx;
  padding: 38.46rpx 34.62rpx;
  align-items: center;
  gap: 30.76923rpx;
  border: 1.92rpx solid #e7eaf0;
  border-radius: 38.46rpx;
  background: #ffffff;
}

.tool-card-icon {
  display: flex;
  width: 115.38rpx;
  height: 115.38rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 34.62rpx;
}

.tool-card-icon--boardgame {
  background: #fff4d6;
}

.tool-card-icon--chwazi {
  background: #e9f7f3;
}

.tool-icon {
  width: 57.69231rpx;
  height: 57.69231rpx;
}

.tool-card-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 9.61538rpx;
}

.tool-card-title {
  overflow: hidden;
  color: #171a24;
  font-size: 34.62rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-card-description {
  overflow: hidden;
  color: #667085;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-card-arrow {
  width: 42.30769rpx;
  height: 42.30769rpx;
  flex: none;
}

.tools-bottom-spacer {
  width: 100%;
}
