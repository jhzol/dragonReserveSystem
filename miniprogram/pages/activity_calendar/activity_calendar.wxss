@import "../../styles/dragonChrome.wxss";

page {
  background: #ffffff;
}

.calendar-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #101828;
}

.calendar-navbar {
  position: relative;
  z-index: 3;
  background-color: transparent;
}

.navbar-row {
  height: 84.62rpx;
  display: flex;
  align-items: center;
  padding-left: 38.46rpx;
  box-sizing: border-box;
}

/* 顶部导航标题：24px 字号、34px 行高。 */
.navbar-main-title {
  flex-shrink: 0;
  font-size: 46.15rpx;
  font-weight: 600;
  line-height: 65.38462rpx;
  color: #0a0a0a;
}

.week-strip {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 3;
  /* Pencil 页面实例：内容最高 63px，另有 8px 底部留白。 */
  height: 136.53846rpx;
  padding: 0;
  box-sizing: border-box;
  /* 与导航栏一致：不铺实底，避免压住 z-index 较低的龙形水印 */
  background: transparent;
  transform: translateZ(0);
  overflow: hidden;
}

.week-strip-slide-wrapper {
  width: 100%;
  background: transparent;
}

.week-strip-swiper {
  width: 100%;
  height: 136.53846rpx;
  box-sizing: border-box;
  background: transparent;
}

.week-strip-swiper-item {
  background: transparent;
}

/* Pencil：水平内边距 24px、justify-between、列宽 36px */
.week-strip-page {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  height: 136.53846rpx;
  padding: 0 46.15385rpx 15.38462rpx;
  box-sizing: border-box;
}

.week-day-strip {
  width: 69.23077rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11.53846rpx;
}

.week-day-strip--today {
  position: relative;
}

.week-strip-label {
  font-size: 23.07692rpx;
  line-height: 32.69231rpx;
  color: #4b5563;
  font-weight: 500;
  text-align: center;
}

.week-strip-label--selected {
  color: #ff9800;
}

.strip-date-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.strip-date-stack--with-event {
  gap: 7.69231rpx;
}

.strip-date-circle {
  width: 69.23077rpx;
  height: 69.23077rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8.65385rpx 0;
}

.strip-date-circle--selected {
  background: #ff9800;
  box-shadow:
    0 1.92308rpx 3.36538rpx -1.92308rpx rgba(0, 0, 0, 0.1),
    0 1.92308rpx 5.04808rpx rgba(0, 0, 0, 0.1);
}

.strip-date-num {
  font-size: 30.76923rpx;
  line-height: 30.76923rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  letter-spacing: -0.6rpx;
}

.strip-date-num--today {
  color: #ff9800;
  font-weight: 600;
}

.strip-date-circle--selected .strip-date-num {
  color: #ffffff;
}

.strip-event-bar {
  width: 23.07692rpx;
  height: 3.84615rpx;
  border-radius: 23.07692rpx;
  background: #ff9800;
  flex-shrink: 0;
}

.calendar-body {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.timeline-days-clip {
  flex: 1;
  position: relative;
  z-index: 1;
  min-width: 0;
  height: 2769.23rpx;
  overflow: hidden;
}

.timeline-days-strip {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100%;
  will-change: transform;
}

.timeline-grid-page {
  flex-shrink: 0;
  height: 100%;
  display: flex;
}

.week-cell {
  width: 96.15385rpx;
  height: 94.23077rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1.92308rpx solid #f5f5f5;
  color: #6a7282;
  font-size: 20rpx;
  box-sizing: border-box;
}

.timeline-above-scroll-gap {
  flex-shrink: 0;
  width: 100%;
  height: 23.08rpx;
  background: #ffffff;
  overflow: hidden;
}

/* 日期栏固定在纵向滚动区上方；右侧标题条与活动网格共享同一横向位移。 */
.timeline-sticky-header {
  position: relative;
  z-index: 10;
  display: flex;
  height: 96.15385rpx;
  background: #ffffff;
  transform: translateZ(0);
  box-sizing: border-box;
  overflow: hidden;
}

.day-titles-clip {
  flex: 1;
  min-width: 0;
  height: 94.23077rpx;
  position: relative;
  overflow: hidden;
}

.day-titles-strip {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 94.23077rpx;
  will-change: transform;
}

.timeline-header-line {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 2;
  height: 1.92308rpx;
  background: #f5f5f5;
  pointer-events: none;
}

.timeline-header-line--top {
  top: 0;
}

.timeline-header-line--bottom {
  bottom: 0;
}

.timeline-sticky-header-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  height: 94.23077rpx;
}

/* 每个标题单元与下方一个活动日列使用完全相同的列宽。 */
.day-titles-strip-cell {
  flex-shrink: 0;
  height: 94.23077rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 7.69231rpx 0;
  border-right: 1.92308rpx solid #f5f5f5;
  color: #101828;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.day-titles-strip-cell--today {
  color: #ff9800;
}

.day-title-text {
  font-size: 23.07692rpx;
  line-height: 23.07692rpx;
  font-weight: 400;
  white-space: nowrap;
}

.time-axis-head-text {
  font-size: 19.23077rpx;
  line-height: 19.23077rpx;
  font-weight: 400;
  white-space: nowrap;
}

.timeline-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #ffffff;
}

.timeline-tab-spacer {
  width: 100%;

  background: transparent;
}

.timeline-grid-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  height: 2769.23rpx;
  min-height: 2769.23rpx;
}

.time-axis {
  width: 96.15385rpx;
  flex-shrink: 0;
  border-right: 1.92308rpx solid #f5f5f5;
  background: #ffffff;
  box-sizing: border-box;
}

.time-axis-head {
  width: 96.15385rpx;
  flex-shrink: 0;
  height: 94.23077rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1.92308rpx solid #f5f5f5;
  color: #4b5563;
  box-sizing: border-box;
  background: #ffffff;
}

.hour-row {
  position: relative;
  height: 115.38rpx;
  box-sizing: border-box;
}

.hour-text {
  position: absolute;
  top: -14.42308rpx;
  right: 9.23077rpx;
  width: 73.07692rpx;
  height: 28.84615rpx;
  padding: 0;
  background: #ffffff;
  color: #99a1af;
  font-size: 19.23077rpx;
  line-height: 28.84615rpx;
  font-weight: 500;
  letter-spacing: 0.22536rpx;
  text-align: center;
}

.day-columns {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: stretch;
}

.day-column {
  position: relative;
  width: 100%;
  height: 100%;
  min-width: 0;
  border-right: 1.92308rpx solid #f5f5f5;
  box-sizing: border-box;
}

.grid-hour {
  height: 115.38rpx;
  border-top: 1.92308rpx solid #f5f5f5;
  box-sizing: border-box;
}

.day-column-body {
  position: relative;
  height: 2769.23rpx;
}

.calendar-event {
  position: absolute;
  left: 3.84615rpx;
  right: 0;
  z-index: 1;
  border-left: 5.76923rpx solid #ff9800;
  border-radius: 7.69231rpx;
  padding: 7.69231rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow:
    0 1.92308rpx 3.36538rpx -1.92308rpx rgba(0, 0, 0, 0.1),
    0 1.92308rpx 5.04808rpx rgba(0, 0, 0, 0.1);
}

.today-fab {
  position: absolute;
  /* 与悬浮 Tab 的页面安全边距对齐 */
  right: 32rpx;
  /* TabBar 高度之上保留操作间距 */

  z-index: 20;
  min-width: 88rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(16, 24, 40, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #101828;
}

.event-title {
  font-size: 23.07692rpx;
  line-height: 33.56643rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-line {
  display: flex;
  align-items: center;
  gap: 3.85rpx;
  margin-top: 4rpx;
  min-width: 0;
}

.event-icon {
  flex-shrink: 0;
  width: 19.23rpx;
  height: 19.23rpx;
}

.event-text {
  min-width: 0;
  font-size: 19.23077rpx;
  line-height: 28.84615rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-status {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 24rpx;
}

.calendar-state {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: #101828;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #6a7282;
}

.state-btn {
  margin-top: 36rpx;
  min-width: 192rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
}

.state-btn::after {
  border: 0;
}

.empty-overlay {
  position: absolute;
  left: 96.15385rpx;
  right: 0;
  top: 220rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}
