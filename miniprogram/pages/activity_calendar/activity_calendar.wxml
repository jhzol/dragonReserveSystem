<view id="qa-calendar-page" class="calendar-page">
  <image class="calendar-watermark dragon-watermark dragon-watermark--fixed" src="../../images/activity-home-logo.png" mode="aspectFit" />

  <view class="calendar-navbar" style="padding-top: {{statusBarHeight}}px">
    <view class="navbar-row" style="padding-right: {{navbarPaddingRightPx}}px">
      <text class="navbar-main-title">日程</text>
    </view>
  </view>

  <view class="week-strip" style="top: calc({{statusBarHeight}}px + 84.61538rpx)">
    <view id="qa-week-strip-slide" class="week-strip-slide-wrapper">
    <swiper
      id="qa-calendar-week-strip"
      class="week-strip-swiper"
      data-role="week-strip"
      circular="{{false}}"
      current="{{weekStripSwiperIndex}}"
      duration="{{weekStripSwiperDuration}}"
      bindchange="onWeekStripSwiperChange"
      bindanimationfinish="onWeekStripSwiperAnimationFinish"
    >
      <swiper-item wx:for="{{weekStripPages}}" wx:key="weekKey" class="week-strip-swiper-item">
        <view class="week-strip-page">
          <view
            wx:for="{{item.days}}"
            wx:for-item="cell"
            wx:key="key"
            class="week-day-strip {{cell.isToday ? 'week-day-strip--today' : ''}}"
            bindtap="onDateTap"
            data-key="{{cell.key}}"
          >
            <text class="week-strip-label {{cell.key === weekStripHighlightKey ? 'week-strip-label--selected' : ''}}">{{cell.weekday}}</text>
            <view class="strip-date-stack {{cell.showStripEventBar ? 'strip-date-stack--with-event' : ''}}">
              <view class="strip-date-circle {{cell.key === weekStripHighlightKey ? 'strip-date-circle--selected' : ''}}">
                <text class="strip-date-num {{cell.isToday && cell.key !== weekStripHighlightKey ? 'strip-date-num--today' : ''}}">{{cell.day}}</text>
              </view>
              <view wx:if="{{cell.showStripEventBar}}" class="strip-event-bar"></view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    </view>
  </view>

  <view wx:if="{{isGuest}}" class="calendar-state">
    <view class="state-title"><text>登录后查看你的活动日程</text></view>
    <view class="state-desc"><text>日程只展示当前账号已经报名的活动</text></view>
    <button class="state-btn" bindtap="goProfile"><text>去登录</text></button>
  </view>

  <view wx:elif="{{loading}}" class="calendar-state">
    <view class="state-title"><text>正在加载日程...</text></view>
  </view>

  <view wx:elif="{{loadError}}" class="calendar-state">
    <view class="state-title"><text>{{loadError}}</text></view>
    <view class="state-desc"><text>请稍后重试</text></view>
    <button class="state-btn" bindtap="onRetry"><text>重新加载</text></button>
  </view>

  <view class="calendar-body" style="top: calc({{statusBarHeight}}px + 221.15385rpx)">
    <view class="timeline-sticky-header">
      <view class="timeline-header-line timeline-header-line--top"></view>
      <view class="timeline-sticky-header-row">
        <view class="time-axis-head"><text class="time-axis-head-text">{{weekNumber}}</text></view>
        <view class="day-titles-clip">
          <view
            id="qa-calendar-day-title-strip"
            class="day-titles-strip"
            style="width: {{timelineSwipePages.length * headerCellWidthPx}}px"
          >
            <view
              wx:for="{{timelineSwipePages}}"
              wx:for-item="dayTitle"
              wx:key="key"
              class="day-titles-strip-cell {{dayTitle.isToday ? 'day-titles-strip-cell--today' : ''}}"
              style="width: {{headerCellWidthPx}}px"
            ><text class="day-title-text">{{dayTitle.title}}</text></view>
          </view>
        </view>
      </view>
      <view class="timeline-header-line timeline-header-line--bottom"></view>
    </view>

    <view class="timeline-above-scroll-gap"></view>

    <scroll-view
      id="qa-calendar-timeline-scroll"
      class="timeline-scroll"
      type="custom"
      scroll-y
      show-scrollbar="{{false}}"
      scroll-top="{{timelineScrollTop}}"
      scroll-with-animation="{{false}}"
      bindscroll="onTimelineScroll"
      worklet:onscrollend="onTimelineVerticalScrollEnd"
    >
      <view class="timeline-grid-body">
        <view class="time-axis time-axis--body">
          <view wx:for="{{hours}}" wx:for-item="hour" wx:key="*this" class="hour-row">
            <text class="hour-text">{{hour}}</text>
          </view>
        </view>

        <horizontal-drag-gesture-handler
          tag="calendar-timeline-drag"
          worklet:ongesture="onTimelineGesture"
        >
          <view class="timeline-days-clip">
            <view
              id="qa-calendar-day-grid-strip"
              class="timeline-days-strip"
              style="width: {{timelineSwipePages.length * headerCellWidthPx}}px"
            >
              <block wx:for="{{timelineSwipePages}}" wx:for-item="day" wx:key="key">
              <view class="timeline-grid-page" style="width: {{headerCellWidthPx}}px">
                <view class="day-columns">
                  <view class="day-column {{day.isToday ? 'day-column-today' : ''}}">
                        <view class="day-column-body">
                          <view wx:for="{{hours}}" wx:for-item="hour" wx:key="*this" class="grid-hour"></view>
                          <view
                            wx:for="{{day.activities}}"
                            wx:for-item="activity"
                            wx:key="_id"
                            class="calendar-event"
                            style="{{activity.style}}"
                            bindtap="onActivityTap"
                            data-id="{{activity._id}}"
                          >
                            <view class="event-title"><text>{{activity.name}}</text></view>
                            <view wx:if="{{activity.locationName}}" class="event-line">
                              <image class="event-icon" src="{{activity.locationIcon}}" mode="aspectFit" />
                              <text class="event-text">{{activity.locationName}}</text>
                            </view>
                            <view class="event-line">
                              <image class="event-icon" src="{{activity.timeIcon}}" mode="aspectFit" />
                              <text class="event-text">{{activity.timeRange}}</text>
                            </view>
                            <view wx:if="{{activity.status === '已取消'}}" class="event-status"><text>已取消</text></view>
                          </view>
                        </view>
                  </view>
                </view>
              </view>
              </block>
            </view>
          </view>
        </horizontal-drag-gesture-handler>
      </view>
      <view class="timeline-tab-spacer" style="height: calc(100rpx + {{bottomSafeAreaRpx}}rpx);"></view>
    </scroll-view>

    <view
      wx:if="{{selectedDateKey && todayDateKey && selectedDateKey !== todayDateKey}}"
      class="today-fab"
      style="bottom: calc(100rpx + {{bottomSafeAreaRpx}}rpx + 76.92308rpx);"
      bindtap="onJumpToToday"
    >
      <text>今天</text>
    </view>

    <view wx:if="{{empty}}" class="empty-overlay">
      <view class="state-title"><text>本周暂无报名活动</text></view>
      <view class="state-desc"><text>报名活动后会在这里生成你的日程</text></view>
    </view>
  </view>
</view>
