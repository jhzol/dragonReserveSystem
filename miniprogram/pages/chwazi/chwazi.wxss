page {
  background: #09090b;
  overflow: hidden;
}

.chwazi-page {
  position: relative;
  display: flex;
  box-sizing: border-box;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  color: #ffffff;
  transition: background-color 0.18s ease;
}

.chwazi-page--selected {
  transition: none;
}

.chwazi-navbar {
  position: relative;
  z-index: 110;
  flex: 0 0 auto;
  box-sizing: border-box;
  height: auto;
  padding-left: 38.46rpx;
  padding-right: 38.46rpx;
}

.chwazi-navbar-inner {
  display: flex;
  box-sizing: border-box;
  height: 84.61538rpx;
  align-items: center;
  justify-content: space-between;
}

.chwazi-back,
.chwazi-navbar-placeholder {
  display: flex;
  width: 61.54rpx;
  height: 61.54rpx;
  align-items: center;
  justify-content: center;
}

.chwazi-back image {
  width: 34.61538rpx;
  height: 34.61538rpx;
  transform: translateX(-7.69231rpx);
}

.chwazi-title {
  color: #ffffff;
  font-size: 38.46154rpx;
  font-weight: 700;
  line-height: 1.4;
}

.chwazi-touch-surface {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
  padding-top: 80.76923rpx;
  overflow: hidden;
}

.chwazi-touch-surface--selected {
  padding-top: 76.92308rpx;
}

.chwazi-stage {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  flex: 1 1 auto;
  overflow: visible;
}

.chwazi-bottom-safe-area {
  flex: 0 0 auto;
}

.touch-point {
  position: absolute;
  width: 230.77rpx;
  height: 230.77rpx;
}

.touch-point--selected {
  z-index: 3;
}

.touch-ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 230.77rpx;
  height: 230.77rpx;
  pointer-events: none;
}

.touch-point--selected::before {
  position: absolute;
  top: -23.08rpx;
  left: -23.08rpx;
  z-index: 0;
  width: 276.92rpx;
  height: 276.92rpx;
  border-radius: 50%;
  background: #09090b;
  content: "";
}

.touch-inner {
  position: absolute;
  z-index: 4;
  width: 157.69rpx;
  height: 157.69rpx;
  border-radius: 50%;
}

.chwazi-too-many {
  position: absolute;
  top: 453.85rpx;
  right: 46.15rpx;
  left: 46.15rpx;
  z-index: 10;
  display: block;
  width: auto;
  color: #ffffff;
  font-size: 32.69rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: center;
  white-space: normal;
}

.chwazi-winner-curtain {
  position: fixed;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.chwazi-winner-collapse-disc {
  position: absolute;
  border-radius: 50%;
  background: #09090b;
  animation-name: chwazi-collapse-to-winner;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  animation-fill-mode: both;
  will-change: transform;
}

@keyframes chwazi-collapse-to-winner {
  from {
    transform: translate(-50%, -50%) scale(1);
  }

  to {
    transform: translate(-50%, -50%) scale(0);
  }
}
