<block wx:if="{{embedded && containerRendered}}">
  <view class="type-sheet-embedded-root" catchtouchmove="stopPropagation">
    <view class="type-sheet-embedded-mask {{containerVisible ? 'type-sheet-embedded-mask--visible' : ''}}" bindtap="onClose"></view>
    <view class="type-sheet-embedded-panel {{containerVisible ? 'type-sheet-embedded-panel--visible' : ''}}">
      <include src="./surface.wxml" />
    </view>
  </view>
</block>

<page-container
  wx:if="{{!embedded && containerRendered}}"
  id="qaActivityTypePickerContainer"
  show="{{containerVisible}}"
  position="bottom"
  overlay="{{true}}"
  round="{{false}}"
  duration="220"
  close-on-slide-down="{{false}}"
  overlay-style="background: rgba(21, 21, 31, 0.4);"
  custom-style="height: 914rpx; max-height: 92vh; background: transparent; border-radius: 48rpx 48rpx 0 0; overflow: hidden;"
  bind:clickoverlay="onClose"
  bind:afterleave="onContainerAfterLeave"
>
  <include src="./surface.wxml" />
</page-container>
