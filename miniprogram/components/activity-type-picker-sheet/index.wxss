.type-sheet-panel {
  position: relative;
  width: 100%;
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.type-sheet-embedded-root {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.type-sheet-embedded-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(21, 21, 31, 0.4);
  opacity: 0;
  transition: opacity 220ms ease-out;
}

.type-sheet-embedded-mask--visible {
  opacity: 1;
}

.type-sheet-embedded-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 914rpx;
  max-height: 100%;
  transform: translateY(100%);
  transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.type-sheet-embedded-panel--visible {
  transform: translateY(0);
}

.type-sheet-header {
  width: 100%;
  height: 112rpx;
  flex: none;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
}

.type-sheet-title {
  color: #000000;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.type-sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-sheet-close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.type-sheet-divider {
  width: 100%;
  height: 2rpx;
  flex: none;
  background: #f5f5f5;
}

.type-sheet-content {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-sizing: border-box;
}

.type-sheet-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-sheet-group + .type-sheet-group {
  margin-top: 32rpx;
}

.type-sheet-group-title {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.type-sheet-options {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-sheet-option {
  width: calc((100% - 20rpx) / 2);
  height: 96rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.type-sheet-option--selected {
  border: 2rpx solid #ff9800;
  background: #fff3e0;
}

.type-sheet-option--pressed {
  opacity: 0.72;
}

.type-sheet-option-label {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.type-sheet-option--selected .type-sheet-option-label {
  color: #ff9800;
  font-weight: 600;
}

.type-sheet-footer {
  width: 100%;
  height: 160rpx;
  flex: none;
  padding: 12rpx 32rpx 60rpx;
  border-top: 2rpx solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.07);
  box-sizing: border-box;
}

.type-sheet-confirm {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.type-sheet-confirm--pressed {
  opacity: 0.82;
}
