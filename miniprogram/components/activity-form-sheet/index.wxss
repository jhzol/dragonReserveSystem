.activity-form-sheet-root {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.activity-form-sheet-root--route-embedded {
  height: 100vh;
}

.activity-cover-picker-host {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.activity-cover-picker-host--visible {
  pointer-events: auto;
}

.activity-form-sheet-dismiss-area {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.activity-sheet-panel {
  position: relative;
  width: 100%;
  height: 100%;
  max-height: 100%;
  padding-top: 30.77rpx;
  padding-bottom: 153.85rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 46.15rpx 46.15rpx 0 0;
  background: #f5f5f5;
  box-shadow: 0 -10rpx 36rpx rgba(65, 74, 138, 0.08);
}

.activity-sheet-panel--covered {
  pointer-events: none;
}

.activity-sheet-panel--route-embedded {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
}

.activity-sheet-header {
  height: 76.92rpx;
  flex: none;
  padding: 0 30.77rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.activity-sheet-title {
  font-size: 38.46rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: #000000;
}

.activity-sheet-close {
  width: 61.54rpx;
  height: 61.54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-sheet-close-icon {
  width: 38.46rpx;
  height: 38.46rpx;
  display: block;
}

.activity-sheet-body {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.bento-grid {
  padding: 15.38rpx 30.77rpx;
  display: flex;
  flex-direction: column;
  gap: 15.38rpx;
  box-sizing: border-box;
}

.bento-card {
  box-sizing: border-box;
  border-radius: 23.08rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bento-card--full {
  width: 100%;
  padding: 15.38rpx 23.08rpx;
}

.bento-card--disabled {
  opacity: 0.64;
}

.bento-label {
  display: block;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.bento-label--strong {
  color: #4b5563;
  font-weight: 600;
}

.activity-time-card,
.deadline-card {
  display: flex;
  flex-direction: column;
  gap: 15.38rpx;
  padding: 15.38rpx 23.08rpx;
}

.activity-time-grid,
.deadline-grid {
  display: flex;
  gap: 15.38rpx;
}

.date-time-row {
  min-width: 0;
  flex: 1;
  padding: 15.38rpx;
  border-radius: 15.38rpx;
  background: #f5f5f5;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15.38rpx;
}

.date-time-row--pressed {
  opacity: 0.72;
}

.date-time-row-label {
  flex: none;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.date-time-row-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 400;
  text-align: right;
}

.date-time-row-value--filled {
  color: #000000;
}

.bento-pair-row {
  width: 100%;
  display: flex;
  gap: 15.38rpx;
}

.bento-card--half {
  min-width: 0;
  flex: 1;
}

.compact-card {
  height: 100rpx;
  padding: 15.38rpx 23.08rpx;
  box-sizing: border-box;
}

.compact-select-card,
.compact-select-row,
.compact-switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.compact-select-row {
  min-width: 0;
  min-height: 44rpx;
  flex: 1;
  justify-content: flex-end;
}

.compact-select-card--pressed {
  opacity: 0.72;
}

.compact-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 400;
}

.compact-value--filled {
  color: #272064;
}

.compact-switch-card {
  height: 100rpx;
}

.prototype-switch {
  width: 88.46rpx;
  height: 53.85rpx;
  flex: none;
  padding: 5.77rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 26.92rpx;
  background: #d1d5db;
  box-sizing: border-box;
}

.prototype-switch--checked {
  justify-content: flex-end;
  background: #ff9800;
}

.prototype-switch-thumb {
  width: 42.31rpx;
  height: 42.31rpx;
  flex: none;
  border-radius: 50%;
  background: #ffffff;
}

.stepper-card {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.stepper {
  flex: none;
  width: 211.54rpx;
  height: 73.08rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 19.23rpx;
  overflow: hidden;
  border-radius: 23.08rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.stepper-button {
  width: 38.46rpx;
  min-width: 38.46rpx;
  max-width: 38.46rpx;
  flex: 0 0 38.46rpx;
  height: 38.46rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-icon {
  width: 38.46rpx;
  height: 38.46rpx;
  display: block;
}

.stepper-button::after {
  border: 0;
}

.stepper-button--disabled {
  opacity: 0.35;
}

.stepper-value {
  width: 42.31rpx;
  min-width: 42.31rpx;
  max-width: 42.31rpx;
  flex: 0 0 42.31rpx;
  text-align: center;
  color: #000000;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.stepper-value-input {
  width: 42.31rpx;
  min-width: 42.31rpx;
  max-width: 42.31rpx;
  flex: 0 0 42.31rpx;
  height: 40rpx;
  min-height: 40rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  color: #000000;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  text-align: center;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.input-count {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 28rpx;
}

.bento-input {
  min-width: 0;
  height: 40rpx;
  flex: 1;
  color: #272064;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.bento-placeholder,
.bento-placeholder-text {
  color: #9ca3af;
  font-weight: 400;
}

.bento-value-row {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bento-value {
  min-width: 0;
  color: #272064;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 400;
}

.bento-value-row--location {
  min-height: 40rpx;
  align-items: center;
}

.bento-value-row--with-address {
  align-items: flex-start;
}

.location-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.location-value {
  color: #272064;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.location-value.bento-placeholder-text {
  color: #9ca3af;
}

.location-address {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 32rpx;
}

.activity-type-chevron {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  display: block;
}

.location-chevron {
  width: 34rpx;
  height: 34rpx;
  margin-top: 3rpx;
  flex: none;
  display: block;
}

.textarea-card {
  min-height: 0;
}

.textarea-input-wrap {
  position: relative;
  width: 100%;
  min-height: 40rpx;
  flex: none;
}

.bento-textarea {
  width: 100%;
  height: 100%;
  min-height: 40rpx;
  color: #272064;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.bento-textarea-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
  pointer-events: none;
}

.textarea-count-row {
  display: flex;
  justify-content: flex-end;
}

.activity-sheet-footer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 153.85rpx;
  padding-bottom: 46.15rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.07);
}

.activity-sheet-footer-actions {
  height: 107.69rpx;
  padding: 11.54rpx 38.46rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 15.38rpx;
  box-sizing: border-box;
}

.sheet-button {
  height: 84.62rpx;
  flex: 1;
  min-width: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 23.08rpx;
  font-size: 26.92rpx;
  line-height: 84.62rpx;
  font-weight: 700;
}

.sheet-button::after {
  border: 0;
}

.sheet-button--primary {
  background: #ff9800;
  color: #ffffff;
}

.sheet-button--danger {
  background: #fff1f0;
  color: #e34d59;
}

.sheet-button--disabled {
  opacity: 0.56;
}

/* 新建活动主抽屉：与最新 Pencil 规范对齐，不影响编辑活动。 */
.activity-sheet-panel--create {
  padding-bottom: 153.85rpx;
}

.bento-grid--create {
  gap: 15.38rpx;
}

.activity-sheet-panel--create .compact-card,
.activity-sheet-panel--create .compact-switch-card {
  height: 100rpx;
}

.activity-sheet-panel--create .compact-select-row {
  gap: 16rpx;
}

.activity-sheet-panel--create .stepper-card {
  min-height: 100rpx;
}

.activity-sheet-panel--create .stepper {
  width: 211.54rpx;
  height: 73.08rpx;
  padding: 0 19.23rpx;
  justify-content: space-between;
  gap: 0;
}

.activity-sheet-panel--create .stepper-button {
  width: 38.46rpx;
  min-width: 38.46rpx;
  max-width: 38.46rpx;
  flex-basis: 38.46rpx;
  height: 38.46rpx;
}

.activity-sheet-panel--create .participant-limit-card--create {
  min-height: 0;
  height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: -12rpx;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transform: translateY(-8rpx);
  transition:
    height 240ms ease,
    min-height 240ms ease,
    padding-top 240ms ease,
    padding-bottom 240ms ease,
    margin-top 240ms ease,
    opacity 160ms ease,
    transform 240ms ease;
}

.activity-sheet-panel--create .participant-limit-card--create.participant-limit-card--visible {
  min-height: 100rpx;
  height: 100rpx;
  padding-top: 15.38rpx;
  padding-bottom: 15.38rpx;
  margin-top: 0;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.create-completed-text,
.create-completed-field .bento-input,
.create-completed-field .bento-textarea {
  color: #111827;
}

.activity-sheet-panel--create .location-chevron {
  margin-top: 0;
  align-self: center;
}

/* 新建活动备注使用受控的 1～5 行高度，避免真机 auto-height 首帧跳变和删除后不回缩。 */
.activity-sheet-panel--create .bento-textarea {
  height: 100%;
  min-height: 48rpx;
  max-height: 200rpx;
  padding: 0;
  line-height: 40rpx;
}

.activity-sheet-footer--create {
  height: 153.85rpx;
  border-top-width: 2rpx;
}

.activity-sheet-footer-actions--create {
  height: 107.69rpx;
  padding: 11.54rpx 38.46rpx;
}

.sheet-button--primary-create {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 编辑活动抽屉：复用公共表单结构，仅覆盖编辑态与最新 Pencil 原型的差异。 */
.activity-sheet-panel--edit {
  padding-bottom: 153.85rpx;
}

.bento-grid--edit {
  gap: 15.38rpx;
}

.activity-sheet-panel--edit .compact-card,
.activity-sheet-panel--edit .compact-switch-card,
.activity-sheet-panel--edit .stepper-card {
  min-height: 100rpx;
  height: 100rpx;
}

.activity-sheet-panel--edit .stepper {
  width: 211.54rpx;
  height: 73.08rpx;
  padding: 0 19.23rpx;
  justify-content: space-between;
  gap: 0;
}

.activity-sheet-panel--edit .stepper-button {
  width: 38.46rpx;
  min-width: 38.46rpx;
  max-width: 38.46rpx;
  flex-basis: 38.46rpx;
  height: 38.46rpx;
}

.activity-sheet-panel--edit .participant-limit-card--edit {
  min-height: 0;
  height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: -12rpx;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transform: translateY(-8rpx);
  transition:
    height 240ms ease,
    min-height 240ms ease,
    padding-top 240ms ease,
    padding-bottom 240ms ease,
    margin-top 240ms ease,
    opacity 160ms ease,
    transform 240ms ease;
}

.activity-sheet-panel--edit .participant-limit-card--edit.participant-limit-card--visible {
  min-height: 100rpx;
  height: 100rpx;
  padding-top: 15.38rpx;
  padding-bottom: 15.38rpx;
  margin-top: 0;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.activity-sheet-panel--edit .date-time-row-value--filled,
.activity-sheet-panel--edit .bento-input,
.activity-sheet-panel--edit .bento-value,
.activity-sheet-panel--edit .location-value,
.activity-sheet-panel--edit .bento-textarea {
  color: #111827;
}

.activity-sheet-panel .location-value.bento-placeholder-text {
  color: #9ca3af;
  font-weight: 400;
}

.activity-sheet-panel--edit .location-chevron {
  margin-top: 0;
  align-self: center;
}

.activity-sheet-panel--edit .bento-textarea {
  height: 100%;
  min-height: 48rpx;
  max-height: 210rpx;
  padding: 0;
  line-height: 42rpx;
}

.activity-sheet-footer--double {
  height: 153.85rpx;
  border-top-width: 2rpx;
}

.activity-sheet-footer-actions--edit {
  height: 107.69rpx;
  padding: 11.54rpx 38.46rpx;
  align-items: center;
  gap: 15.38rpx;
}

.sheet-button--secondary-edit {
  width: 215.38rpx;
  flex: 0 0 215.38rpx;
  border: 2rpx solid #ff9800;
  background: transparent;
  color: #ff9800;
  font-weight: 600;
}

.sheet-button--primary-edit {
  flex: 1;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
