<view class="activity-form-sheet-root {{routeEmbedded ? 'activity-form-sheet-root--route-embedded' : ''}}">
  <view wx:if="{{routeEmbedded && visible}}" class="activity-form-sheet-dismiss-area" bindtap="onClose"></view>

  <block wx:if="{{routeEmbedded && visible}}">
    <include src="./surface.wxml" />
  </block>

  <page-container
  wx:if="{{!routeEmbedded && containerRendered}}"
  id="qaActivityFormContainer"
  show="{{containerVisible}}"
  position="bottom"
  overlay="{{true}}"
  round="{{false}}"
  duration="240"
  close-on-slide-down="{{false}}"
  overlay-style="background: rgba(23, 24, 20, 0.4);"
  custom-style="height: {{panelHeightRpx}}rpx; background: transparent; border-radius: 46.15rpx 46.15rpx 0 0; overflow: hidden;"
  bind:clickoverlay="onClose"
  bind:afterleave="onContainerAfterLeave"
  >
    <include src="./surface.wxml" />
  </page-container>

  <activity-cover-picker-sheet
  id="qaActivityCoverPickerSheet"
  class="activity-cover-picker-host {{coverPickerVisible ? 'activity-cover-picker-host--visible' : ''}}"
  visible="{{coverPickerVisible}}"
  embedded="{{routeEmbedded}}"
  value="{{form.activityCoverId}}"
  bindclose="closeCoverPicker"
  bindconfirm="confirmCoverPicker"
  />

  <date-time-picker-sheet
  wx:if="{{!externalDateTimePicker}}"
  id="qaDateTimePickerSheet"
  visible="{{pickerVisible}}"
  embedded="{{routeEmbedded}}"
  mode="{{pickerMode}}"
  title="{{pickerTitle}}"
  value="{{pickerValue}}"
  bottom-offset-rpx="{{routeEmbedded ? 323.08 : 0}}"
  minute-step="{{5}}"
  bindclose="closeDateTimePicker"
  bindconfirm="confirmDateTimePicker"
  />

  <create-access-dialog
    id="qaCancelActivityDialog"
    bindconfirm="confirmCancelActivity"
  />
</view>
