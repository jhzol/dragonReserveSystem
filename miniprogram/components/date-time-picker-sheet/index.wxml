<block wx:if="{{embedded && containerRendered}}">
  <view class="picker-sheet-embedded-root" catchtouchmove="stopPropagation">
    <view class="picker-sheet-embedded-mask {{containerVisible ? 'picker-sheet-embedded-mask--visible' : ''}}" bindtap="onClose"></view>
    <view class="picker-sheet-embedded-panel {{containerVisible ? 'picker-sheet-embedded-panel--visible' : ''}}">
      <include src="./surface.wxml" />
    </view>
  </view>
</block>

<page-container
  wx:if="{{!embedded && containerRendered}}"
  id="qaDateTimePickerContainer"
  show="{{containerVisible}}"
  position="bottom"
  overlay="{{true}}"
  round="{{false}}"
  duration="220"
  close-on-slide-down="{{false}}"
  overlay-style="background: rgba(21, 21, 31, 0.4);"
  custom-style="height: 761.54rpx; max-height: 92vh; bottom: {{bottomOffsetRpx}}rpx; background: transparent; border-radius: 46.15rpx 46.15rpx 0 0; overflow: hidden;"
  bind:clickoverlay="onClose"
  bind:afterleave="onContainerAfterLeave"
>
  <include src="./surface.wxml" />
</page-container>
