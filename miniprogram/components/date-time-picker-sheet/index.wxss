.picker-sheet-panel {
  position: relative;
  width: 100%;
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 46.15rpx 46.15rpx 0 0;
  overflow: hidden;
}

.picker-sheet-embedded-root {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.picker-sheet-embedded-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(21, 21, 31, 0.4);
  opacity: 0;
  transition: opacity 220ms ease-out;
}

.picker-sheet-embedded-mask--visible {
  opacity: 1;
}

.picker-sheet-embedded-panel {
  position: absolute;
  right: 0;
  bottom: -761.54rpx;
  left: 0;
  height: 761.54rpx;
  max-height: 100%;
  transition: bottom 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.picker-sheet-embedded-panel--visible {
  bottom: 0;
}

.picker-sheet-header {
  height: 107.69rpx;
  padding: 0 38.46rpx;
  display: flex;
  align-items: center;
  gap: 23.08rpx;
  box-sizing: border-box;
}

.picker-sheet-title {
  color: #000000;
  font-size: 30.77rpx;
  line-height: 42.31rpx;
  font-weight: 600;
}

.picker-sheet-close {
  width: 61.54rpx;
  height: 61.54rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-sheet-close-icon {
  width: 38.46rpx;
  height: 38.46rpx;
  display: block;
}

.picker-sheet-divider {
  height: 1.92rpx;
  background: #f5f5f5;
}

.picker-sheet-wheel {
  position: relative;
  width: 100%;
  height: 498.08rpx;
  flex: none;
  overflow: hidden;
  background: #ffffff;
}

.picker-sheet-selection {
  position: absolute;
  z-index: 0;
  top: 201.92rpx;
  height: 92.31rpx;
  border-radius: 23.08rpx;
  background: #f5f5f5;
  pointer-events: none;
  box-sizing: border-box;
}

.picker-sheet-selection--date,
.picker-sheet-selection--datetime {
  left: 30.77rpx;
  right: 30.77rpx;
}

.picker-sheet-selection--time {
  left: 76.92rpx;
  right: 76.92rpx;
}

.picker-sheet-view {
  position: absolute;
  z-index: 1;
  top: 17.31rpx;
  left: 0;
  width: 100%;
  height: 461.54rpx;
  display: flex;
  box-sizing: border-box;
}

.picker-sheet-view--date {
  padding: 0 30.77rpx;
}

.picker-sheet-view--datetime {
  padding: 0 30.77rpx;
}

.picker-sheet-view--time {
  padding: 0 76.92rpx;
}

.picker-sheet-column {
  height: 461.54rpx;
}

.picker-sheet-view--date .picker-sheet-column--year {
  width: 192.31rpx;
  flex: none;
}

.picker-sheet-view--date .picker-sheet-column--month {
  width: 192.31rpx;
  flex: none;
}

.picker-sheet-view--date .picker-sheet-column--day {
  min-width: 0;
  flex: 1;
}

.picker-sheet-view--time .picker-sheet-column--hour,
.picker-sheet-view--time .picker-sheet-column--minute {
  width: 278.85rpx;
  flex: none;
}

.picker-sheet-view--time .picker-sheet-column--minute {
  margin-left: 38.46rpx;
}

.picker-sheet-view--datetime .picker-sheet-column--year {
  width: 96.15rpx;
  flex: none;
}

.picker-sheet-view--datetime .picker-sheet-column--month {
  width: 92.31rpx;
  flex: none;
}

.picker-sheet-view--datetime .picker-sheet-column--day {
  width: 246.15rpx;
  flex: none;
}

.picker-sheet-view--datetime .picker-sheet-column--hour,
.picker-sheet-view--datetime .picker-sheet-column--minute {
  width: 126.92rpx;
  flex: none;
}

.picker-sheet-view--datetime .picker-sheet-column--hour {
  margin-left: 0;
}

.picker-sheet-item {
  height: 92.31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #000000;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
  font-weight: 400;
  white-space: nowrap;
}

.picker-sheet-item--selected {
  font-weight: 600;
}

.picker-sheet-item--spacer {
  color: transparent;
}

.picker-sheet-muted-mask {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  pointer-events: none;
}

.picker-sheet-muted-mask--top {
  top: 0;
  height: 201.92rpx;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.94),
    rgba(255, 255, 255, 0.72) 52%,
    rgba(255, 255, 255, 0.58)
  );
}

.picker-sheet-muted-mask--bottom {
  top: 294.23rpx;
  height: 203.85rpx;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.58),
    rgba(255, 255, 255, 0.72) 48%,
    rgba(255, 255, 255, 0.94)
  );
}


.picker-sheet-footer {
  position: relative;
  z-index: 4;
  height: 153.85rpx;
  padding-top: 11.54rpx;
  padding-bottom: 57.69rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.07);
}

.picker-sheet-confirm {
  width: calc(100% - 61.54rpx);
  height: 84.62rpx;
  margin: 0 30.77rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 23.08rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
  font-weight: 700;
}

.picker-sheet-confirm--pressed {
  opacity: 0.86;
}
