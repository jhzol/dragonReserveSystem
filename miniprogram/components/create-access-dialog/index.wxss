:host {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  background: transparent;
  pointer-events: none;
}

.create-access-dialog-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: rgba(23, 24, 20, 0.4);
  pointer-events: auto;
  animation-name: createAccessMaskIn;
  animation-duration: 160ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

.create-access-dialog {
  display: flex;
  box-sizing: border-box;
  width: 576.92308rpx;
  max-width: calc(100% - 64rpx);
  padding: 38.46154rpx;
  align-items: center;
  flex-direction: column;
  gap: 30.76923rpx;
  border-radius: 30.76923rpx;
  background: #ffffff;
  box-shadow: 0 19.23077rpx 53.84615rpx rgba(0, 0, 0, 0.15);
  animation-name: createAccessDialogIn;
  animation-duration: 200ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

.create-access-dialog-copy {
  display: flex;
  width: 100%;
  align-items: center;
  flex-direction: column;
  gap: 23.07692rpx;
}

.create-access-dialog-title-row {
  display: flex;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  gap: 15.38462rpx;
}

.create-access-dialog-icon {
  display: block;
  width: 34.61538rpx;
  height: 34.61538rpx;
  flex: none;
}

.create-access-dialog-title {
  display: block;
  color: #111827;
  font-size: 30.76923rpx;
  line-height: 42.30769rpx;
  font-weight: 700;
  text-align: center;
}

.create-access-dialog-message {
  display: block;
  width: 100%;
  color: #4b5563;
  font-size: 26.92308rpx;
  line-height: 40.38462rpx;
  font-weight: 400;
  text-align: center;
}

.create-access-dialog-actions {
  display: flex;
  width: 100%;
  gap: 23.07692rpx;
}

.create-access-dialog-button {
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  height: 84.61538rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 23.07692rpx;
  font-size: 26.92308rpx;
  line-height: 38.46154rpx;
  font-weight: 600;
}

.create-access-dialog-button--cancel {
  color: #4b5563;
  background: #f5f5f5;
}

.create-access-dialog-button--confirm {
  color: #ffffff;
  background: #ff9800;
}

@keyframes createAccessMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes createAccessDialogIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
