.cover-sheet-embedded-root {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 20;
}

.cover-sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(21, 21, 31, 0.4);
  opacity: 0;
  transition: opacity 240ms ease-out;
}

.cover-sheet-mask--visible { opacity: 1; }

.cover-sheet-embedded-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1384.62rpx;
  max-height: 92%;
  transform: translateY(100%);
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.cover-sheet-embedded-panel--visible { transform: translateY(0); }

.cover-sheet-panel {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 42.31rpx 42.31rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.cover-sheet-header {
  width: 100%;
  height: 107.69rpx;
  flex: none;
  padding: 0 38.46rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.cover-sheet-title {
  color: #000000;
  font-size: 30.77rpx;
  line-height: 42.31rpx;
  font-weight: 600;
}

.cover-sheet-close {
  width: 61.54rpx;
  height: 61.54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-sheet-close-icon { width: 38.46rpx; height: 38.46rpx; display: block; }
.cover-sheet-divider { width: 100%; height: 1.92rpx; flex: none; background: #f5f5f5; }

.cover-sheet-content {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  margin-top: 23.08rpx;
  margin-bottom: 23.08rpx;
  box-sizing: border-box;
}

.cover-artist-group {
  width: 100%;
  height: 369.23rpx;
  padding: 0 0 0 30.77rpx;
  display: flex;
  flex-direction: column;
  gap: 19.23rpx;
  box-sizing: border-box;
}

.cover-artist-group + .cover-artist-group { margin-top: 46.15rpx; }

.cover-artist-header {
  height: 53.85rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 15.38rpx;
}

.cover-artist-avatar {
  width: 53.85rpx;
  height: 53.85rpx;
  flex: none;
  border-radius: 50%;
  background: #f5f5f5;
}

.cover-artist-name {
  color: #374151;
  font-size: 26.92rpx;
  line-height: 38.46rpx;
  font-weight: 600;
}

.cover-artwork-track {
  width: 100%;
  height: 296.15rpx;
  flex: none;
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.cover-artwork {
  position: relative;
  width: 296.15rpx;
  min-width: 296.15rpx;
  height: 296.15rpx;
  flex: 0 0 296.15rpx;
  margin-right: 23.08rpx;
  overflow: visible;
  border: 0;
  border-radius: 23.08rpx;
  background: #f5f5f5;
  box-sizing: border-box;
  animation-name: cover-artwork-enter;
  animation-duration: 560ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

@keyframes cover-artwork-enter {
  from {
    opacity: 0;
    transform: translateY(23.08rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cover-artwork:last-child { margin-right: 30.77rpx; }
.cover-artwork-transition,
.cover-artwork-media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 23.08rpx;
}

.cover-artwork-image { width: 100%; height: 100%; display: block; }

.cover-sheet-skeleton {
  width: 100%;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 23.08rpx 0;
  overflow: hidden;
  box-sizing: border-box;
}

.cover-sheet-skeleton-list {
  width: 100%;
  padding: 0 30.77rpx;
  box-sizing: border-box;
}

.cover-skeleton-group {
  width: 100%;
  height: 369.23rpx;
  display: flex;
  flex-direction: column;
  gap: 19.23rpx;
  overflow: hidden;
}

.cover-skeleton-group + .cover-skeleton-group { margin-top: 46.15rpx; }

.cover-skeleton-header {
  width: 100%;
  height: 53.85rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 15.38rpx;
}

.cover-skeleton-block {
  flex: none;
  position: relative;
  overflow: hidden;
  background-color: #eaecef;
}

.cover-skeleton-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 72%;
  height: 100%;
  background-image: linear-gradient(
    90deg,
    rgba(248, 249, 251, 0) 0%,
    rgba(248, 249, 251, 0.24) 22%,
    rgba(248, 249, 251, 0.52) 42%,
    rgba(248, 249, 251, 0.52) 58%,
    rgba(248, 249, 251, 0.24) 78%,
    rgba(248, 249, 251, 0) 100%
  );
  transform: translateX(-100%);
  pointer-events: none;
  animation-name: cover-skeleton-shimmer;
  animation-duration: 1800ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.cover-skeleton-avatar {
  width: 53.85rpx;
  height: 53.85rpx;
  border-radius: 50%;
}

.cover-skeleton-name {
  width: 169.23rpx;
  height: 26.92rpx;
  border-radius: 13.46rpx;
}

.cover-skeleton-track {
  width: 100%;
  height: 296.15rpx;
  flex: none;
  display: flex;
  flex-direction: row;
  gap: 23.08rpx;
  overflow: hidden;
}

.cover-skeleton-card {
  width: 296.15rpx;
  min-width: 296.15rpx;
  height: 296.15rpx;
  border-radius: 23.08rpx;
}

@keyframes cover-skeleton-shimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(150%); }
}

.cover-artwork-border {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  border: 1.92rpx solid #e5e7eb;
  border-radius: 23.08rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.cover-artwork--selected .cover-artwork-border {
  border-width: 5.77rpx;
  border-color: #ff9800;
}

.cover-artwork-check {
  position: absolute;
  top: 15.38rpx;
  right: 15.38rpx;
  width: 53.85rpx;
  height: 53.85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ff9800;
  z-index: 3;
}

.cover-artwork-check-icon { width: 32.69rpx; height: 32.69rpx; display: block; }

.cover-artwork-preview {
  position: absolute;
  right: 15.38rpx;
  bottom: 15.38rpx;
  width: 53.85rpx;
  height: 53.85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.85);
  z-index: 3;
}

.cover-artwork-preview-icon { width: 28.85rpx; height: 28.85rpx; display: block; }

.cover-sheet-status {
  flex: 1 1 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.cover-sheet-retry {
  height: 72rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 72rpx;
}
.cover-sheet-retry::after { border: 0; }

.cover-sheet-footer {
  width: 100%;
  height: 153.85rpx;
  flex: none;
  padding: 11.54rpx 38.46rpx 57.69rpx;
  border-top: 1.92rpx solid #f5f5f5;
  background: #ffffff;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.cover-sheet-confirm {
  width: auto;
  min-width: 0;
  height: 84.62rpx;
  flex: 1;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 23.08rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff9800;
  color: #ffffff;
  font-size: 26.92rpx;
  line-height: 84.62rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.cover-sheet-confirm-label {
  color: #ffffff;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
  text-align: center;
}

.cover-sheet-confirm--disabled {
  background: #e5e7eb;
  color: #9ca3af;
}

.cover-sheet-confirm--disabled .cover-sheet-confirm-label {
  color: #9ca3af;
}

.cover-preview {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  overflow: hidden;
  background: #08090b;
  color: #ffffff;
}

.cover-preview-nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  padding: 0;
  box-sizing: border-box;
  background: #08090b;
}

.cover-preview-titlebar {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.cover-preview-nav-button {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 19.23rpx;
  width: 84.62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-preview-back-icon {
  width: 34.62rpx;
  height: 34.62rpx;
  display: block;
}

.cover-preview-count {
  position: absolute;
  left: 50%;
  width: 384.62rpx;
  transform: translateX(-50%);
  color: #ffffff;
  font-size: 38.46rpx;
  line-height: 53.85rpx;
  font-weight: 700;
  text-align: center;
}

.cover-preview-nav-spacer {
  position: absolute;
  right: 0;
  width: 158.65rpx;
  height: 100%;
  pointer-events: none;
}

.cover-preview-stage {
  position: absolute;
  right: 0;
  bottom: 345.15rpx;
  left: 0;
  overflow: hidden;
  background: #0d0f12;
}

.cover-preview-swiper,
.cover-preview-slide { width: 100%; height: 100%; }
.cover-preview-slide { display: flex; align-items: center; justify-content: center; }
.cover-preview-image { width: 100%; height: 100%; display: block; }

.cover-preview-arrow {
  position: absolute;
  top: 503.85rpx;
  width: 76.92rpx;
  height: 76.92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38.46rpx;
  background: rgba(0, 0, 0, 0.4);
}
.cover-preview-arrow--left { left: 23.08rpx; }
.cover-preview-arrow--right { right: 23.08rpx; }
.cover-preview-arrow-icon { width: 38.46rpx; height: 38.46rpx; display: block; }

.cover-preview-info {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 346.15rpx;
  padding: 0;
  border: 0;
  border-top: 0;
  box-shadow: none;
  background: #111318;
  box-sizing: border-box;
}

.cover-preview-artist {
  position: absolute;
  top: 30.77rpx;
  right: 30.77rpx;
  left: 30.77rpx;
  height: 69.23rpx;
  display: flex;
  align-items: center;
  gap: 23.08rpx;
}
.cover-preview-avatar { width: 69.23rpx; height: 69.23rpx; flex: none; border-radius: 50%; }
.cover-preview-artist-copy { display: flex; flex-direction: column; }
.cover-preview-artist-name { color: #ffffff; font-size: 26.92rpx; line-height: 38.46rpx; font-weight: 600; }
.cover-preview-hint { color: rgba(255, 255, 255, 0.6); font-size: 23.08rpx; line-height: 30.77rpx; font-weight: 400; }

.cover-preview-confirm {
  position: absolute;
  top: 146.15rpx;
  right: 38.46rpx;
  left: 38.46rpx;
  width: auto;
  height: 84.62rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 23.08rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15.38rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 26.92rpx;
  line-height: 84.62rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.cover-preview-confirm-icon { width: 30.77rpx; height: 30.77rpx; }
.cover-preview-safe-area {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 73.08rpx;
  pointer-events: none;
}
